@inject IDecompilerBackend Backend
@inject IJSRuntime JS

<div class="explorer-tree" @ref="viewport" @oncontextmenu="e => OnEmptyContextMenu.InvokeAsync(e)" @oncontextmenu:preventDefault>
  @if (Assemblies.Count == 0)
  {
    <div class="empty">@EmptyMessage</div>
  }
  else
  {
    <Virtualize Items="visible" Context="item" ItemSize="RowHeight" OverscanCount="12">
      <button @key="item.Node.Id" class="tree-row @(IsRowSelected(item.Node) ? "selected" : null)" style="--depth:@item.Depth" title="@(item.Framework is null ? item.Tooltip ?? item.Node.Tooltip ?? item.Node.Detail : null)" @onmouseenter="e => PositionTooltip(e, item)" @onclick="e => SelectAsync(item.Node, e)" @oncontextmenu="e => OpenContextMenuAsync(item.Node, e)" @oncontextmenu:preventDefault @oncontextmenu:stopPropagation>
        <span class="chevron" @onclick="() => ToggleAsync(item.Node)" @onclick:stopPropagation="true">@(item.Node.HasChildren ? (expanded.Contains(item.Node.Id) ? "▾" : "▸") : "")</span>@if (ShowIcon(item.Node.Kind)) { <span class="node-icon @item.Node.Kind.ToString().ToLowerInvariant()">@Icon(item.Node.Kind)</span> }@if (item.Node.Visibility is not null && item.Node.Kind != TreeNodeKind.Type) { <span class="meta-visibility">@item.Node.Visibility</span> }@if (item.Node.TypeDisplay is not null) { <span class="meta-type meta-type-@item.Node.TypeClassification">@item.Node.TypeDisplay</span> }<span class="meta-name meta-@item.Node.NameClassification">@{ var name = SplitGenericName(item.Node.Name); }@name.Base@foreach (var part in name.Generic) { <span class="@(part.IsParameter ? "meta-typeparam" : "meta-generic-punctuation")">@part.Text</span> }</span>@if (item.Node.Detail is not null) { <small>@item.Node.Detail</small> }
        @if (item.Framework is not null) { <span class="assembly-tooltip" style="left:@(tooltipX)px;top:@(tooltipY)px"><span class="assembly-tooltip-label">Target framework</span><strong>@item.Framework</strong><span class="assembly-tooltip-label">Loaded from</span><code>@item.LoadedFrom</code></span> }
      </button>
    </Virtualize>
  }
</div>

@code {
  private const int RowHeight = 22;
  [Parameter, EditorRequired] public IReadOnlyList<AssemblyDescriptor> Assemblies { get; set; } = [];
  [Parameter] public string EmptyMessage { get; set; } = "Open a managed .dll or .exe to begin.";
  [Parameter] public EventCallback<NavigationRequest> OnOpen { get; set; }
  [Parameter] public EventCallback<NodeId> OnOpenReference { get; set; }
  [Parameter] public EventCallback<(NodeId Resource, bool NewTab)> OnOpenResource { get; set; }
  [Parameter] public EventCallback<(MouseEventArgs Event, TreeNodeDescriptor Node)> OnContextMenu { get; set; }
  // Fired on a right-click that isn't on a node (empty space, or the "open a file" placeholder) — the host
  // shows an "Open assembly" menu there. Row right-clicks stop propagation, so only true empty space reaches here.
  [Parameter] public EventCallback<MouseEventArgs> OnEmptyContextMenu { get; set; }
  [Parameter] public IReadOnlySet<NodeId>? ExpandedPath { get; set; }
  [Parameter] public SymbolId? SelectedSymbol { get; set; }
  [Parameter] public NodeId? SelectedNode { get; set; }
  // Session ids of assemblies in the multi-selection (Ctrl+A / Delete). Their root rows render as selected.
  [Parameter] public IReadOnlySet<Guid>? SelectedAssemblies { get; set; }
  [Parameter] public EventCallback OnClearSelection { get; set; }
  [Parameter] public EventCallback<Guid> OnToggleAssembly { get; set; }
  [Parameter] public int SelectionVersion { get; set; }
  [Parameter] public int CollapseVersion { get; set; }

  private ElementReference viewport;
  private readonly Dictionary<NodeId, IReadOnlyList<TreeNodeDescriptor>> children = [];
  private readonly HashSet<NodeId> expanded = [];
  private IReadOnlyList<FlatNode> roots = [];
  private ICollection<FlatNode> visible = Array.Empty<FlatNode>();
  private int handledCollapseVersion;
  private int handledSelectionVersion = -1;
  private HashSet<NodeId> appliedPath = [];
  private bool scrollToSelection;
  private double tooltipX;
  private double tooltipY;

  private void PositionTooltip(MouseEventArgs e, FlatNode item)
  {
    if (item.Framework is null) return;
    tooltipX = e.ClientX + 12;
    tooltipY = e.ClientY + 12;
  }

  protected override async Task OnParametersSetAsync()
  {
    roots = Assemblies.Select(assembly => new FlatNode(
      new TreeNodeDescriptor(assembly.RootNode, assembly.Name, TreeNodeKind.Assembly, true),
      0,
      Framework: assembly.TargetFramework,
      LoadedFrom: Path.GetDirectoryName(assembly.Path)))
      .ToArray();
    var validSessions = Assemblies.Select(assembly => assembly.SessionId).ToHashSet();
    foreach (var key in children.Keys.Where(key => !validSessions.Contains(key.SessionId)).ToArray()) children.Remove(key);
    expanded.RemoveWhere(key => !validSessions.Contains(key.SessionId));
    if (CollapseVersion > 0 && CollapseVersion != handledCollapseVersion)
    {
      handledCollapseVersion = CollapseVersion;
      expanded.Clear();
      handledSelectionVersion = SelectionVersion;
      appliedPath = ExpandedPath?.ToHashSet() ?? [];
    }
    RebuildVisible();
    var pathChanged = ExpandedPath is not null && !appliedPath.SetEquals(ExpandedPath);
    if (SelectionVersion != handledSelectionVersion || pathChanged)
    {
      handledSelectionVersion = SelectionVersion;
      await ExpandPathAsync();
      appliedPath = ExpandedPath?.ToHashSet() ?? [];
      scrollToSelection = true;
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!scrollToSelection) return;
    scrollToSelection = false;
    var index = visible.ToList().FindIndex(item => IsSelected(item.Node));
    if (index >= 0) await JS.InvokeVoidAsync("dnSpyXdx.scrollTreeToIndex", viewport, index, RowHeight);
  }

  private async Task ExpandPathAsync()
  {
    if (ExpandedPath is null || ExpandedPath.Count == 0) return;
    while (true)
    {
      var item = visible.FirstOrDefault(candidate => candidate.Node.HasChildren && ExpandedPath.Contains(candidate.Node.Id) && !expanded.Contains(candidate.Node.Id));
      if (item is null) break;
      await LoadChildrenAsync(item.Node);
      expanded.Add(item.Node.Id);
      RebuildVisible();
    }
  }

  private async Task ToggleAsync(TreeNodeDescriptor node)
  {
    if (!node.HasChildren) return;
    if (!expanded.Remove(node.Id))
    {
      await LoadChildrenAsync(node);
      expanded.Add(node.Id);
    }
    RebuildVisible();
  }

  private async Task LoadChildrenAsync(TreeNodeDescriptor node)
  {
    if (!children.ContainsKey(node.Id)) children[node.Id] = await Backend.GetChildrenAsync(node.Id);
  }

  private void RebuildVisible()
  {
    var flattened = new List<FlatNode>();
    foreach (var root in roots) Append(root, flattened);
    visible = flattened;
    StateHasChanged();
  }

  private void Append(FlatNode item, List<FlatNode> flattened)
  {
    flattened.Add(item);
    if (!expanded.Contains(item.Node.Id) || !children.TryGetValue(item.Node.Id, out var descendants)) return;
    foreach (var child in descendants) Append(new FlatNode(child, item.Depth + 1), flattened);
  }

  private async Task SelectAsync(TreeNodeDescriptor node, MouseEventArgs e)
  {
    // Ctrl/Cmd+click on an assembly adds or removes it from the multi-selection (dnSpy-style), without
    // expanding it or disturbing the rest of the selection.
    if (node.Kind == TreeNodeKind.Assembly && (e.CtrlKey || e.MetaKey))
    {
      await OnToggleAssembly.InvokeAsync(node.Id.SessionId);
      return;
    }
    // A plain click is a fresh single selection, so drop any multi-selection built with Ctrl+A first.
    if (SelectedAssemblies is { Count: > 0 }) await OnClearSelection.InvokeAsync();
    if (node.Symbol is { } symbol) await OnOpen.InvokeAsync(new NavigationRequest(symbol, e.CtrlKey, node.Kind, node.Name));
    else if (node.Kind == TreeNodeKind.Reference) await OnOpenReference.InvokeAsync(node.Id);
    else if (node.Kind == TreeNodeKind.Resource) await OnOpenResource.InvokeAsync((node.Id, e.CtrlKey || e.MetaKey));
    else await ToggleAsync(node);
  }

  private Task OpenContextMenuAsync(TreeNodeDescriptor node, MouseEventArgs e) => HasContextMenu(node) ? OnContextMenu.InvokeAsync((e, node)) : Task.CompletedTask;
  // Assembly nodes have their unload menu; symbol-bearing nodes (types and members) get the Analyze menu.
  private static bool HasContextMenu(TreeNodeDescriptor node) => node.Kind == TreeNodeKind.Assembly || node.Symbol is not null;
  private bool IsSelected(TreeNodeDescriptor node) => node.Id == SelectedNode || node.Symbol is { } symbol && symbol == SelectedSymbol;
  private bool IsRowSelected(TreeNodeDescriptor node) => IsSelected(node) || (node.Kind == TreeNodeKind.Assembly && SelectedAssemblies is not null && SelectedAssemblies.Contains(node.Id.SessionId));
  private static bool ShowIcon(TreeNodeKind kind) => kind is TreeNodeKind.Assembly or TreeNodeKind.Group or TreeNodeKind.Reference or TreeNodeKind.Resource;
  private static string Icon(TreeNodeKind kind) => kind switch { TreeNodeKind.Assembly => "◈", TreeNodeKind.Namespace => "N", TreeNodeKind.Type => "C", TreeNodeKind.Method or TreeNodeKind.Constructor => "M", TreeNodeKind.Property => "P", TreeNodeKind.Field => "F", TreeNodeKind.Event => "E", TreeNodeKind.Reference => "↗", TreeNodeKind.Resource => "◆", _ => "▦" };

  // Splits a type name such as Dictionary<TKey, TValue> into its base name and the generic clause so
  // the tree can color the parameter names (TKey, TValue) apart from the class, mirroring dnSpy. A
  // type node's generic arguments are always its own parameters, so every identifier inside <> is one.
  private static (string Base, IReadOnlyList<GenericPart> Generic) SplitGenericName(string name)
  {
    var angle = name.IndexOf('<');
    if (angle < 0) return (name, Array.Empty<GenericPart>());
    var parts = new List<GenericPart>();
    var index = angle;
    while (index < name.Length)
    {
      var start = index;
      var isIdentifier = char.IsLetter(name[index]) || name[index] == '_';
      if (isIdentifier) while (index < name.Length && (char.IsLetterOrDigit(name[index]) || name[index] == '_')) index++;
      else while (index < name.Length && !(char.IsLetter(name[index]) || name[index] == '_')) index++;
      parts.Add(new GenericPart(name[start..index], isIdentifier));
    }
    return (name[..angle], parts);
  }

  private readonly record struct GenericPart(string Text, bool IsParameter);
  private sealed record FlatNode(TreeNodeDescriptor Node, int Depth, string? Tooltip = null, string? Framework = null, string? LoadedFrom = null);
}
