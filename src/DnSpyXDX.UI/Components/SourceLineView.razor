<div class="source-line @(WrapLines ? "wrap-lines" : null) @(IsFocused ? "code-search-focus" : null)" style="@LineStyle" data-source-line="@Line.Number" role="row">
  <button type="button"
          class="source-breakpoint-gutter @(Breakpoint is null ? null : "set") @(Binding?.IsVerified == true ? "verified" : null) @(IsCurrentStatement ? "current" : null)"
          title="@BreakpointTitle"
          aria-label="@BreakpointTitle"
          disabled="@(DebugPoint is null)"
          @onclick="ToggleBreakpointAsync"></button>
  <span class="source-line-number" aria-hidden="true">@(Line.Number + 1)</span>
  <code>
    @foreach (var brace in VisibleGuides())
    {
      <i class="source-brace-guide" style="left:@($"calc({brace.Column}ch + .5ch)")" aria-hidden="true"></i>
    }
    @foreach (var segment in Segments())
    {
      var text = Line.Text.Substring(segment.Start, segment.Length);
      var matchClass = segment.IsActiveMatch ? "source-find-match active" : segment.IsMatch ? "source-find-match" : null;
      var debugVariable = DebugVariableFor(segment.Token);
      if (segment.Token.Target is { } target)
      {
        <button type="button" class="source-token @CssClass(segment.Token) code-link @(debugVariable is null ? null : "debug-local") @matchClass" data-symbol="@segment.Token.SymbolName" data-debug-local="@debugVariable?.Name" data-debug-value="@debugVariable?.Value" data-debug-type="@debugVariable?.Type" title="@(debugVariable is null ? segment.Token.Tooltip ?? $"Go to {segment.Token.SymbolName}" : null)" aria-label="@DebugVariableTitle(debugVariable)" @onclick="e => NavigateAsync(target, e)" @oncontextmenu="e => AnalyzeAsync(target, segment.Token, e)" @oncontextmenu:preventDefault="@(AnalyzableKind(segment.Token.Kind) is not null)">@text</button>
      }
      else if (segment.Token.DocumentOffset is { } offset)
      {
        <button type="button" class="source-token @CssClass(segment.Token) code-link @(debugVariable is null ? null : "debug-local") @matchClass" data-debug-local="@debugVariable?.Name" data-debug-value="@debugVariable?.Value" data-debug-type="@debugVariable?.Type" title="@(debugVariable is null ? segment.Token.Tooltip ?? "Go to IL instruction" : null)" aria-label="@DebugVariableTitle(debugVariable)" @onclick="e => NavigateOffsetAsync(offset, e)">@text</button>
      }
      else
      {
        <span class="source-token @CssClass(segment.Token) @(segment.Token.SymbolName is null ? null : "code-link") @(debugVariable is null ? null : "debug-local") @matchClass" data-symbol="@segment.Token.SymbolName" data-debug-local="@debugVariable?.Name" data-debug-value="@debugVariable?.Value" data-debug-type="@debugVariable?.Type" aria-label="@DebugVariableTitle(debugVariable)">@text</span>
      }
    }
  </code>
</div>

@code {
  private const int MaximumGuides = 32;

  [Parameter, EditorRequired] public SourceTokenizedLine Line { get; set; } = null!;
  [Parameter] public EventCallback<NavigationRequest> OnNavigate { get; set; }
  [Parameter] public EventCallback<int> OnNavigateOffset { get; set; }
  [Parameter] public EventCallback<AnalyzeRequest> OnAnalyze { get; set; }
  [Parameter] public IReadOnlyDictionary<string, DebugVariable> DebugVariables { get; set; } =
    new Dictionary<string, DebugVariable>();
  [Parameter] public IReadOnlyList<SourceFindSpan> Matches { get; set; } = [];
  [Parameter] public int ActiveMatchOffset { get; set; } = -1;
  [Parameter] public int FocusedLine { get; set; } = -1;
  [Parameter] public int LineHeight { get; set; } = 20;
  [Parameter] public bool WrapLines { get; set; }
  [Parameter] public DebugDocumentSequencePoint? DebugPoint { get; set; }
  [Parameter] public DebugBreakpoint? Breakpoint { get; set; }
  [Parameter] public DebugBreakpointBinding? Binding { get; set; }
  [Parameter] public bool IsCurrentStatement { get; set; }
  [Parameter] public EventCallback<DebugCodeLocation> OnToggleBreakpoint { get; set; }

  private bool IsFocused => FocusedLine == Line.Number;
  private string BreakpointTitle => DebugPoint is null
    ? "No executable statement on this line"
    : Breakpoint is null
      ? "Add breakpoint"
      : Binding?.Message ?? (Binding?.IsVerified == true ? "Bound breakpoint" : "Remove breakpoint");
  private string LineStyle => WrapLines ? $"--continuation-indent:{LeadingColumns() + SourceDocumentModel.TabWidth}ch" : $"height:{LineHeight}px";
  private Task ToggleBreakpointAsync() => DebugPoint is { } point
    ? OnToggleBreakpoint.InvokeAsync(point.BreakpointLocation ?? point.Location)
    : Task.CompletedTask;

  private int LeadingColumns()
  {
    var columns = 0;
    foreach (var character in Line.Text)
    {
      if (character == '\t') columns += SourceDocumentModel.TabWidth - columns % SourceDocumentModel.TabWidth;
      else if (character == ' ') columns++;
      else break;
    }
    return columns;
  }

  private Task NavigateAsync(SymbolId target, MouseEventArgs e) =>
    e.AltKey || e.ShiftKey ? Task.CompletedTask : OnNavigate.InvokeAsync(new NavigationRequest(target, e.CtrlKey || e.MetaKey));
  private Task NavigateOffsetAsync(int offset, MouseEventArgs e) =>
    e.AltKey || e.ShiftKey ? Task.CompletedTask : OnNavigateOffset.InvokeAsync(offset);

  private Task AnalyzeAsync(SymbolId target, SourceToken token, MouseEventArgs e) =>
    AnalyzableKind(token.Kind) is { } kind
      ? OnAnalyze.InvokeAsync(new AnalyzeRequest(target, token.SymbolName ?? "", kind, e.ClientX, e.ClientY))
      : Task.CompletedTask;

  private DebugVariable? DebugVariableFor(SourceToken token)
  {
    if (token.Kind != SourceTokenKind.Identifier || DebugVariables.Count == 0)
      return null;
    var name = Line.Text.Substring(token.Start, token.Length);
    if (name.StartsWith('@')) name = name[1..];
    return DebugVariables.TryGetValue(name, out var variable) ? variable : null;
  }

  private static string? DebugVariableTitle(DebugVariable? variable) =>
    variable is null
      ? null
      : string.IsNullOrWhiteSpace(variable.Type)
        ? $"{variable.Name} = {variable.Value}"
        : $"{variable.Name} = {variable.Value}{Environment.NewLine}{variable.Type}";

  // References the analyzer can act on (types and members) get an Analyze context menu.
  private static TreeNodeKind? AnalyzableKind(SourceTokenKind kind) => kind switch
  {
    SourceTokenKind.Type or SourceTokenKind.StaticType or SourceTokenKind.Interface or SourceTokenKind.Enum or SourceTokenKind.Struct or SourceTokenKind.Delegate => TreeNodeKind.Type,
    SourceTokenKind.Method => TreeNodeKind.Method,
    SourceTokenKind.Field => TreeNodeKind.Field,
    SourceTokenKind.Property => TreeNodeKind.Property,
    SourceTokenKind.Event => TreeNodeKind.Event,
    _ => null
  };

  private IEnumerable<SourceBrace> VisibleGuides()
  {
    var closingPairs = Line.Tokens
      .Where(token => token.Kind == SourceTokenKind.Brace && token.BracePair is not null && Line.Text[token.Start] == '}')
      .Select(token => token.BracePair!.Value)
      .ToHashSet();
    return Line.StartState.Braces.Take(MaximumGuides).Where(brace => !closingPairs.Contains(brace.Pair));
  }

  private IEnumerable<RenderedSegment> Segments()
  {
    // The common case is no active find: every token renders as a single segment, so skip the per-token
    // boundary machinery (a SortedSet, an array, and a scan) that only exists to split tokens around matches.
    if (Matches.Count == 0)
    {
      foreach (var token in Line.Tokens)
        yield return new RenderedSegment(token, token.Start, token.Length, false, false);
      yield break;
    }
    foreach (var token in Line.Tokens)
    {
      var boundaries = new SortedSet<int> { token.Start, token.Start + token.Length };
      foreach (var match in Matches)
      {
        var start = Math.Max(token.Start, match.Start);
        var end = Math.Min(token.Start + token.Length, match.Start + match.Length);
        if (start < end) { boundaries.Add(start); boundaries.Add(end); }
      }
      var points = boundaries.ToArray();
      for (var index = 0; index < points.Length - 1; index++)
      {
        var start = points[index];
        var length = points[index + 1] - start;
        var match = Matches.FirstOrDefault(candidate => start >= candidate.Start && start < candidate.Start + candidate.Length);
        var isMatch = match.Length > 0;
        yield return new RenderedSegment(token, start, length, isMatch, isMatch && match.DocumentOffset == ActiveMatchOffset);
      }
    }
  }

  private static string? CssClass(SourceToken token) => token.Kind switch
  {
    SourceTokenKind.Comment => "code-comment",
    SourceTokenKind.String => "code-string",
    SourceTokenKind.Number => "code-number",
    SourceTokenKind.Keyword => "code-keyword",
    SourceTokenKind.ControlKeyword => "code-control",
    SourceTokenKind.Visibility => "code-visibility",
    SourceTokenKind.BuiltInType => "code-standard-type",
    SourceTokenKind.Constant => "code-constant",
    SourceTokenKind.Type => "code-type",
    SourceTokenKind.StaticType => "code-static-type",
    SourceTokenKind.Interface => "code-interface",
    SourceTokenKind.Enum => "code-enum",
    SourceTokenKind.Struct => "code-struct",
    SourceTokenKind.Delegate => "code-delegate",
    SourceTokenKind.TypeParameter => "code-type-param",
    SourceTokenKind.Method => "code-method",
    SourceTokenKind.Field => "code-field",
    SourceTokenKind.Property => "code-property",
    SourceTokenKind.Event => "code-event",
    SourceTokenKind.EnumMember => "code-enum-member",
    SourceTokenKind.Namespace => "code-namespace",
    SourceTokenKind.Identifier => "code-name",
    SourceTokenKind.Brace => "code-brace",
    _ => null
  };

  private readonly record struct RenderedSegment(SourceToken Token, int Start, int Length, bool IsMatch, bool IsActiveMatch);
}
