@implements IAsyncDisposable
@inject IJSRuntime JS
@inject SourceViewStateStore ViewStates
@inject SourcePresentationCache Cache
@inject Microsoft.Extensions.Logging.ILogger<SourceView> Logger
@inject DebuggerWorkspace Debugger

@if (findOpen)
{
  <div class="source-find" role="search">
    <input @ref="findInput" @bind="findQuery" @bind:event="oninput" @bind:after="QueueFind" placeholder="Find in document" aria-label="Find in document" />
    <span class="source-find-count">@(matches.Count == 0 ? "No results" : $"{matchIndex + 1} of {matches.Count}")</span>
    <button title="Previous match (Shift+Enter)" aria-label="Previous match" disabled="@(matches.Count == 0)" @onclick="FindPreviousAsync">↑</button>
    <button title="Next match (Enter)" aria-label="Next match" disabled="@(matches.Count == 0)" @onclick="FindNextAsync">↓</button>
    <button title="Close (Escape)" aria-label="Close find" @onclick="CloseFindAsync">×</button>
  </div>
}
@if (preparationError is not null)
{
  <div class="source-preparing source-preparing-error">Could not prepare source: @preparationError</div>
}
else if (model is null)
{
  <div class="source-preparing"><span class="decompiling-spinner"></span>Preparing source…</div>
}
else
{
  <div class="source-viewport @(WrapLines ? "wrap-lines" : null)" @ref="viewport" tabindex="0" role="region" aria-label="Decompiled source">
    <div class="source-canvas" style="min-width:@(WrapLines ? "100%" : CanvasWidth)">
      @if (WrapLines)
      {
        @foreach (var line in wrappedLines)
        {
          <SourceLineView @key="line.Number" Line="line" LineHeight="LineHeight" WrapLines="true" Matches="FindSpans(line.Number)" ActiveMatchOffset="ActiveMatchOffset" FocusedLine="focusedLine" OnNavigate="NavigateAsync" OnNavigateOffset="NavigateOffsetAsync" OnAnalyze="OnAnalyze" DebugPoint="DebugPoint(line.Number)" Breakpoint="Breakpoint(line.Number)" Binding="BreakpointBinding(line.Number)" IsCurrentStatement="IsCurrentStatement(line.Number)" OnToggleBreakpoint="ToggleBreakpointAsync" />
        }
      }
      else
      {
        <Virtualize @key="model.Key" @ref="virtualizer" ItemsProvider="LoadLinesAsync" ItemSize="LineHeight" OverscanCount="Overscan">
          <ItemContent Context="line">
            <SourceLineView @key="line.Number" Line="line" LineHeight="LineHeight" Matches="FindSpans(line.Number)" ActiveMatchOffset="ActiveMatchOffset" FocusedLine="focusedLine" OnNavigate="NavigateAsync" OnNavigateOffset="NavigateOffsetAsync" OnAnalyze="OnAnalyze" DebugPoint="DebugPoint(line.Number)" Breakpoint="Breakpoint(line.Number)" Binding="BreakpointBinding(line.Number)" IsCurrentStatement="IsCurrentStatement(line.Number)" OnToggleBreakpoint="ToggleBreakpointAsync" />
          </ItemContent>
          <Placeholder Context="placeholder">
            <div class="source-line source-line-placeholder" style="height:@(LineHeight)px" aria-hidden="true">
              <span class="source-line-number">@(placeholder.Index + 1)</span>
              <code><span class="source-placeholder-bar" style="width:@PlaceholderWidth(placeholder.Index)ch"></span></code>
            </div>
          </Placeholder>
        </Virtualize>
      }
    </div>
  </div>
}

@code {
  private const int LineHeight = 20;
  private const int Overscan = 10;
  private const int MaximumCanvasColumns = 20_000;

  [Parameter, EditorRequired] public DecompilerDocument Document { get; set; } = null!;
  [Parameter, EditorRequired] public string TabId { get; set; } = "";
  [Parameter] public EventCallback<NavigationRequest> OnNavigate { get; set; }
  [Parameter] public EventCallback<AnalyzeRequest> OnAnalyze { get; set; }
  [Parameter] public bool WrapLines { get; set; }

  private ElementReference viewport;
  private ElementReference findInput;
  private Virtualize<SourceTokenizedLine>? virtualizer;
  private DotNetObjectReference<SourceView>? selfReference;
  private SourceDocumentModel? model;
  private SourceDocumentKey? modelKey;
  private string? modelTabId;
  private IDisposable? modelLease;
  private CancellationTokenSource? preparation;
  private CancellationTokenSource? findDelay;
  private CancellationTokenSource? focusDelay;
  private IReadOnlyList<int> matches = [];
  private IReadOnlyDictionary<int, IReadOnlyList<SourceFindSpan>> findSpans = new Dictionary<int, IReadOnlyList<SourceFindSpan>>();
  private int matchIndex = -1;
  private string findQuery = "";
  private bool findOpen;
  private bool focusFind;
  private bool initializeBrowser;
  private string? preparationError;
  private bool revealFocus;
  private bool revealCurrentStatement;
  private (SourceDocumentKey Document, SymbolId Symbol)? revealedFocus;
  private int focusedLine = -1;
  private bool modelWrapLines;
  private IReadOnlyList<SourceTokenizedLine> wrappedLines = [];
  private int? currentStatementLine;

  private string CanvasWidth => $"max(100%, calc(74px + {Math.Min(model?.MaximumVisualColumns ?? 0, MaximumCanvasColumns)}ch))";
  private int ActiveMatchOffset => matchIndex >= 0 && matchIndex < matches.Count ? matches[matchIndex] : -1;

  protected override void OnInitialized()
  {
    Debugger.Changed += DebuggerChanged;
  }

  protected override async Task OnParametersSetAsync()
  {
    var key = SourceDocumentKey.Create(Document);
    if (modelKey == key && model?.Text == Document.Text && modelTabId == TabId)
    {
      if (modelWrapLines != WrapLines)
      {
        await CaptureViewStateAsync();
        modelWrapLines = WrapLines;
        wrappedLines = WrapLines ? await LoadWrappedLinesAsync(model, preparation?.Token ?? default) : [];
        initializeBrowser = true;
      }
      revealFocus = Document.FocusSymbol is { } focus && revealedFocus != (key, focus);
      return;
    }

    await CaptureViewStateAsync();
    preparation?.Cancel();
    preparation?.Dispose();
    preparation = new CancellationTokenSource();
    var token = preparation.Token;
    model = null;
    preparationError = null;
    modelLease?.Dispose();
    modelLease = null;
    modelKey = key;
    modelTabId = TabId;
    modelWrapLines = WrapLines;
    wrappedLines = [];
    matches = [];
    findSpans = new Dictionary<int, IReadOnlyList<SourceFindSpan>>();
    matchIndex = -1;
    try
    {
      var prepared = await Cache.GetModelAsync(key, Document.Text, token);
      token.ThrowIfCancellationRequested();
      model = prepared;
      currentStatementLine = DebuggerSourceMap.FindLine(
        Document.DebugMap,
        prepared,
        Debugger.Snapshot.Stop?.Location);
      revealCurrentStatement = currentStatementLine is not null;
      if (WrapLines) wrappedLines = await LoadWrappedLinesAsync(prepared, token);
      modelLease = Cache.Activate(key);
      initializeBrowser = true;
      revealFocus = Document.FocusSymbol is { } focus && revealedFocus != (key, focus);
      // Warm the tokenizer checkpoints in the background so scrollbar jumps into unseen regions fill their
      // placeholder rows quickly instead of replaying the tokenizer from far back. Wrap mode already tokenizes
      // the whole document up front, so it needs no warming.
      if (!WrapLines && !prepared.CheckpointsWarmed) _ = WarmCheckpointsSafeAsync(prepared, Document, token);
    }
    catch (OperationCanceledException) { }
    catch (Exception ex)
    {
      preparationError = ex.Message;
      Microsoft.Extensions.Logging.LoggerExtensions.LogError(Logger, ex, "Could not prepare {Language} source for tab {TabId}", Document.Language, TabId);
    }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (model is null) return;
    if (selfReference is null) selfReference = DotNetObjectReference.Create(this);
    if (initializeBrowser)
    {
      initializeBrowser = false;
      await JS.InvokeVoidAsync("dnSpyXdx.initSourceFind", viewport, selfReference);
      await JS.InvokeVoidAsync("dnSpyXdx.initSourceHover", viewport);
      var state = ViewStates.TryGet(TabId, model.Key, out var saved) ? saved : new SourceViewState(0, 0);
      await JS.InvokeVoidAsync("dnSpyXdx.setSourceScroll", viewport, state.ScrollTop, state.ScrollLeft);
    }
    if (revealFocus && Document.FocusSymbol is { } focus && TryGetFocusPosition(focus, out var position, out var declarationOffset))
    {
      revealFocus = false;
      revealedFocus = (model.Key, focus);
      focusedLine = Math.Min(position.Line + declarationOffset, model.LineCount - 1);
      if (virtualizer is not null) await virtualizer.RefreshDataAsync();
      if (WrapLines) await JS.InvokeVoidAsync("dnSpyXdx.scrollSourceToRenderedLine", viewport, focusedLine);
      else await JS.InvokeVoidAsync("dnSpyXdx.scrollSourceToLine", viewport, focusedLine, LineHeight);
      focusDelay?.Cancel();
      focusDelay?.Dispose();
      focusDelay = new CancellationTokenSource();
      _ = ClearFocusAsync(focusDelay.Token);
    }
    if (revealCurrentStatement && currentStatementLine is { } statementLine)
    {
      revealCurrentStatement = false;
      await JS.InvokeVoidAsync(
        WrapLines
          ? "dnSpyXdx.scrollSourceToRenderedLine"
          : "dnSpyXdx.scrollSourceToLine",
        viewport,
        statementLine,
        LineHeight);
    }
    if (focusFind) { focusFind = false; await findInput.FocusAsync(); }
  }

  private bool TryGetFocusPosition(SymbolId focus, out SourcePosition position, out int declarationOffset)
  {
    if (Document.SymbolLocations?.TryGetValue(focus.MetadataToken, out var offset) == true)
    {
      position = model!.GetPosition(offset);
      declarationOffset = 0;
      return true;
    }
    if (model!.TryGetTokenLocation(focus.MetadataToken, out position)) { declarationOffset = 1; return true; }
    declarationOffset = 0;
    return false;
  }

  private async ValueTask<ItemsProviderResult<SourceTokenizedLine>> LoadLinesAsync(ItemsProviderRequest request)
  {
    if (model is null) return new ItemsProviderResult<SourceTokenizedLine>([], 0);
    try
    {
      var lines = await Cache.GetLinesAsync(model, request.StartIndex, request.Count, Document.SymbolLinks, Document.TypeClassifications, Document.References, Document.SemanticSpans, request.CancellationToken);
      return new ItemsProviderResult<SourceTokenizedLine>(lines, model.LineCount);
    }
    catch (OperationCanceledException)
    {
      // A fast scrollbar drag supersedes in-flight windows, cancelling their requests. Virtualize only
      // suppresses a cancellation that carries its own request token, but the cache links that token with an
      // eviction token before handing it to the tokenizer, so the exception surfaces with the linked token and
      // Virtualize would rethrow it straight into BuildRenderTree and tear down the view. Re-throw against the
      // request's own token so Virtualize recognises and swallows it; if the cancellation came from elsewhere
      // (eviction), yield nothing gracefully instead of letting it escape.
      request.CancellationToken.ThrowIfCancellationRequested();
      return new ItemsProviderResult<SourceTokenizedLine>([], model?.LineCount ?? 0);
    }
  }

  private Task<IReadOnlyList<SourceTokenizedLine>> LoadWrappedLinesAsync(SourceDocumentModel document, CancellationToken token) =>
    document.TokenizeLinesAsync(0, document.LineCount, Document.SymbolLinks, Document.TypeClassifications, Document.References, Document.SemanticSpans, token);

  private static async Task WarmCheckpointsSafeAsync(SourceDocumentModel document, DecompilerDocument source, CancellationToken token)
  {
    try { await document.WarmCheckpointsAsync(source.SymbolLinks, source.TypeClassifications, source.References, source.SemanticSpans, token); }
    catch (OperationCanceledException) { }
    catch { /* best-effort; the only cost of failure is a slower first jump into a cold region */ }
  }

  // A deterministic but varied width for a loading row's shimmer bar, so a screenful of placeholders reads
  // like code lines of differing lengths rather than identical blocks. Cosmetic only.
  private static int PlaceholderWidth(int index) => 8 + index * 37 % 48;

  [JSInvokable]
  public void OpenFind()
  {
    findOpen = true;
    focusFind = true;
    StateHasChanged();
  }

  private void QueueFind()
  {
    findDelay?.Cancel();
    findDelay?.Dispose();
    findDelay = new CancellationTokenSource();
    _ = FindAfterDelayAsync(findDelay.Token);
  }

  private async Task FindAfterDelayAsync(CancellationToken token)
  {
    try { await Task.Delay(150, token); await FindAsync(token); }
    catch (OperationCanceledException) { }
  }

  private async Task FindAsync(CancellationToken token)
  {
    if (model is null || string.IsNullOrEmpty(findQuery))
    {
      matches = [];
      findSpans = new Dictionary<int, IReadOnlyList<SourceFindSpan>>();
      matchIndex = -1;
    }
    else
    {
      var text = model.Text;
      var query = findQuery;
      matches = await Task.Run<IReadOnlyList<int>>(() =>
      {
        var found = new List<int>();
        for (var offset = 0; offset <= text.Length - query.Length;)
        {
          token.ThrowIfCancellationRequested();
          var match = text.IndexOf(query, offset, StringComparison.OrdinalIgnoreCase);
          if (match < 0) break;
          found.Add(match);
          offset = match + Math.Max(1, query.Length);
        }
        return found;
      }, token);
      matchIndex = matches.Count == 0 ? -1 : 0;
      findSpans = BuildFindSpans(model, matches, query.Length);
    }
    await InvokeAsync(async () =>
    {
      if (virtualizer is not null) await virtualizer.RefreshDataAsync();
      StateHasChanged();
      if (matchIndex >= 0) await RevealMatchAsync();
    });
  }

  private Task FindNextAsync() => MoveFindAsync(1);
  private Task FindPreviousAsync() => MoveFindAsync(-1);

  private async Task MoveFindAsync(int direction)
  {
    if (matches.Count == 0) return;
    matchIndex = (matchIndex + direction + matches.Count) % matches.Count;
    await RevealMatchAsync();
    StateHasChanged();
  }

  private async Task RevealMatchAsync()
  {
    if (model is null || matchIndex < 0) return;
    var line = model.GetPosition(matches[matchIndex]).Line;
    await JS.InvokeVoidAsync("dnSpyXdx.scrollSourceToLine", viewport, line, LineHeight);
  }

  [JSInvokable]
  public async Task SourceFindKey(string key, bool shift)
  {
    if (key == "Enter") await MoveFindAsync(shift ? -1 : 1);
    else if (key == "Escape") await CloseFindAsync();
  }

  private async Task CloseFindAsync()
  {
    findDelay?.Cancel();
    findOpen = false;
    findQuery = "";
    matches = [];
    findSpans = new Dictionary<int, IReadOnlyList<SourceFindSpan>>();
    matchIndex = -1;
    if (virtualizer is not null) await virtualizer.RefreshDataAsync();
    await InvokeAsync(StateHasChanged);
  }

  private Task NavigateAsync(NavigationRequest request) =>
    request.Symbol == Document.Symbol && !request.NewTab ? Task.CompletedTask : OnNavigate.InvokeAsync(request);

  private async Task NavigateOffsetAsync(int offset)
  {
    if (model is null) return;
    var position = model.GetPosition(offset);
    focusedLine = position.Line;
    if (virtualizer is not null) await virtualizer.RefreshDataAsync();
    await JS.InvokeVoidAsync("dnSpyXdx.scrollSourceToLine", viewport, position.Line, LineHeight);
    focusDelay?.Cancel();
    focusDelay?.Dispose();
    focusDelay = new CancellationTokenSource();
    _ = ClearFocusAsync(focusDelay.Token);
  }

  private IReadOnlyList<SourceFindSpan> FindSpans(int line) =>
    findSpans.TryGetValue(line, out var spans) ? spans : [];

  private DebugDocumentSequencePoint? DebugPoint(int line) =>
    model is null
      ? null
      : DebuggerSourceMap.FindForLine(Document.DebugMap, model, line);

  private DebugBreakpoint? Breakpoint(int line) =>
    DebugPoint(line) is { } point
      ? Debugger.BreakpointAt(point.Location)
      : null;

  private DebugBreakpointBinding? BreakpointBinding(int line) =>
    Breakpoint(line) is { } breakpoint
      ? Debugger.BindingFor(breakpoint.Id)
      : null;

  private bool IsCurrentStatement(int line) => currentStatementLine == line;
  private Task ToggleBreakpointAsync(DebugCodeLocation location) =>
    Debugger.ToggleBreakpointAsync(location);

  private void DebuggerChanged()
  {
    if (model is not null)
    {
      var nextLine = DebuggerSourceMap.FindLine(
        Document.DebugMap,
        model,
        Debugger.Snapshot.Stop?.Location);
      revealCurrentStatement =
        nextLine is not null &&
        nextLine != currentStatementLine;
      currentStatementLine = nextLine;
    }
    _ = InvokeAsync(async () =>
    {
      if (virtualizer is not null) await virtualizer.RefreshDataAsync();
      StateHasChanged();
    });
  }

  private static IReadOnlyDictionary<int, IReadOnlyList<SourceFindSpan>> BuildFindSpans(SourceDocumentModel document, IReadOnlyList<int> offsets, int length)
  {
    var byLine = new Dictionary<int, List<SourceFindSpan>>();
    foreach (var offset in offsets)
    {
      var remaining = length;
      var position = document.GetPosition(offset);
      var line = position.Line;
      var column = position.Column;
      while (remaining > 0 && line < document.LineCount)
      {
        var available = document.GetLine(line).Length - column;
        var take = Math.Min(remaining, Math.Max(0, available));
        if (take > 0)
        {
          if (!byLine.TryGetValue(line, out var spans)) byLine[line] = spans = [];
          spans.Add(new SourceFindSpan(column, take, offset));
          remaining -= take;
        }
        if (remaining == 0) break;
        line++;
        column = 0;
        // A multi-line query consumes at least one newline code unit between source rows.
        remaining = Math.Max(0, remaining - 1);
      }
    }
    return byLine.ToDictionary(pair => pair.Key, pair => (IReadOnlyList<SourceFindSpan>)pair.Value);
  }

  private async Task ClearFocusAsync(CancellationToken token)
  {
    try
    {
      await Task.Delay(1_200, token);
      await InvokeAsync(() => { focusedLine = -1; StateHasChanged(); });
    }
    catch (OperationCanceledException) { }
  }

  public async ValueTask DisposeAsync()
  {
    Debugger.Changed -= DebuggerChanged;
    await CaptureViewStateAsync();
    preparation?.Cancel();
    preparation?.Dispose();
    findDelay?.Cancel();
    findDelay?.Dispose();
    focusDelay?.Cancel();
    focusDelay?.Dispose();
    try { await JS.InvokeVoidAsync("dnSpyXdx.disposeSourceFind", viewport); await JS.InvokeVoidAsync("dnSpyXdx.disposeSourceHover", viewport); }
    catch (JSDisconnectedException) { }
    selfReference?.Dispose();
    modelLease?.Dispose();
  }

  private async Task CaptureViewStateAsync()
  {
    if (modelKey is not { } key || string.IsNullOrEmpty(modelTabId)) return;
    try
    {
      var scroll = await JS.InvokeAsync<SourceScrollPosition>("dnSpyXdx.getSourceScroll", viewport);
      ViewStates.Set(modelTabId, key, new SourceViewState(scroll.ScrollTop, scroll.ScrollLeft, matchIndex >= 0 ? matchIndex : null));
    }
    catch (InvalidOperationException) { }
    catch (JSDisconnectedException) { }
  }

  private sealed record SourceScrollPosition(double ScrollTop, double ScrollLeft);
}
