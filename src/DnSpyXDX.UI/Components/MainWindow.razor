  // Right-clicking a search result offers Analyze, the same as the tree and source view. Search reports its
  // kind as a string ("Type", "Method", …) which maps straight onto TreeNodeKind.
  private void OpenSearchResultAnalyzeMenu(SearchResult result, MouseEventArgs e)
  {
