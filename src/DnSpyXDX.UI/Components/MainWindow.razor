  public async Task DebuggerKeyCommand(string command)
  {
    var state = DebuggerUi;
    switch (command)
    {
      case "startContinue":
        if (state.CanStart) OpenDebugDialog();
        else if (state.CanContinue) await Debugger.ContinueAsync();
        break;
      case "stop" when state.CanStop:
        await Debugger.TerminateAsync();
        break;
      case "restart" when state.CanRestart:
        await Debugger.RestartAsync();
        break;
      case "pause" when state.CanPause:
        await Debugger.PauseAsync();
        break;
      case "stepOver" when state.CanStep:
        await Debugger.StepAsync(DebugStepKind.Over);
        break;
      case "stepInto" when state.CanStep:
        await Debugger.StepAsync(DebugStepKind.Into);
        break;
      case "stepOut" when state.CanStep:
        await Debugger.StepAsync(DebugStepKind.Out);
        break;
    }
  }
