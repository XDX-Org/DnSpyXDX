@implements IDisposable
@inject IDecompilerBackend Backend
@inject IProjectExportService Exporter
@inject IFileDialogService Dialogs
@inject WorkspaceState Workspace
@inject IJSRuntime JS
@inject IWorkspaceSessionService Session
@inject IApplicationZoomService Zoom
@inject IApplicationLifetime ApplicationLifetime
@inject SourceViewStateStore SourceViewStates
@inject SourcePresentationCache SourceCache
@inject WorkspaceAssemblyService Assemblies
@inject RuntimeLoggingSettings LoggingSettings
@inject RuntimeDisplaySettings DisplaySettings
@inject McpServerSettings McpSettings
@inject IMcpServerService McpServer
@inject DebuggerWorkspace Debugger

<div class="app-shell">
  <header class="toolbar">
    <div class="app-menu">
      <button type="button" class="hamburger" title="Application menu" aria-label="Application menu" aria-expanded="@menuOpen" @onclick="ToggleMenu" @onclick:stopPropagation><span></span><span></span><span></span></button>
      @if (menuOpen) {
        <div class="menu-dismiss" @onclick="CloseMenu"></div>
        <div class="menu-popup">
          <div class="menu-identity"><img src="_content/DnSpyXDX.UI/images/dnspyxdx-logo.webp" alt=""><span>DnSpyXDX</span></div>
          <button @onclick="OpenFromMenuAsync" disabled="@Workspace.IsBusy"><span>Open assembly</span></button>
          <button @onclick="ExportFromMenuAsync" disabled="@(Workspace.IsBusy || Backend.Assemblies.Count == 0)"><span>Extract solution</span></button>
          <button @onclick="UnloadAllAsync" disabled="@(Workspace.IsBusy || Backend.Assemblies.Count == 0)"><span>Unload all assemblies</span></button>
          <div class="menu-separator" role="separator"></div>
          <button @onclick="OpenSettings"><span>Settings</span></button>
          <button @onclick="Exit"><span>Exit</span></button>
        </div>
      }
    </div>
    <div class="toolbar-navigation" aria-label="Document navigation">
      <button class="toolbar-icon" title="Back (Alt+Left)" aria-label="Back" disabled="@(Workspace.ActiveTab?.CanGoBack != true)" @onclick="() => NavigateHistory(false)">←</button>
      <button class="toolbar-icon" title="Forward (Alt+Right)" aria-label="Forward" disabled="@(Workspace.ActiveTab?.CanGoForward != true)" @onclick="() => NavigateHistory(true)">→</button>
    </div>
    <button class="toolbar-icon search-toolbar-button @(bottomOpen ? "active" : null)" title="@(bottomOpen ? "Close bottom panel" : Backend.Assemblies.Count == 0 ? "Open MCP activity" : "Open search")" aria-label="@(bottomOpen ? "Close bottom panel" : Backend.Assemblies.Count == 0 ? "Open MCP activity" : "Open search")" aria-pressed="@bottomOpen" @onclick="ToggleBottomPanel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="1.5"></rect><path d="M3 14h18"></path><path d="m9 17 3 3 3-3"></path></svg>
    </button>
    <div class="debug-toolbar" aria-label="Debugger controls">
      <button class="toolbar-icon" title="Start or attach debugger" aria-label="Start or attach debugger" disabled="@Debugger.IsBusy" @onclick="OpenDebugDialog">▶</button>
      <button class="toolbar-icon" title="Continue" aria-label="Continue" disabled="@(Debugger.IsBusy || Debugger.Snapshot.Status != DebugSessionStatus.Paused)" @onclick="() => Debugger.ContinueAsync()">▷</button>
      <button class="toolbar-icon" title="Pause" aria-label="Pause" disabled="@(Debugger.IsBusy || Debugger.Snapshot.Status != DebugSessionStatus.Running)" @onclick="() => Debugger.PauseAsync()">Ⅱ</button>
      <button class="toolbar-icon" title="Stop debugging" aria-label="Stop debugging" disabled="@(!DebuggerActive)" @onclick="() => Debugger.TerminateAsync()">■</button>
      <button class="toolbar-icon debug-step" title="Step into" aria-label="Step into" disabled="@(!DebuggerPaused)" @onclick="() => Debugger.StepAsync(DebugStepKind.Into)">↓</button>
      <button class="toolbar-icon debug-step" title="Step over" aria-label="Step over" disabled="@(!DebuggerPaused)" @onclick="() => Debugger.StepAsync(DebugStepKind.Over)">↷</button>
      <button class="toolbar-icon debug-step" title="Step out" aria-label="Step out" disabled="@(!DebuggerPaused)" @onclick="() => Debugger.StepAsync(DebugStepKind.Out)">↑</button>
    </div>
    <label class="language-selector"><span>Language</span><select value="@language" @onchange="LanguageChangedAsync"><option value="@DecompilerLanguage.CSharp">C#</option><option value="@DecompilerLanguage.IL">IL</option><option value="@DecompilerLanguage.ILWithCSharp">IL with C#</option><option value="@DecompilerLanguage.Hex">Hex</option></select></label>
  </header>
  <main>
    <div class="explorer-pane" @ref="explorer" style="width:@($"{explorerWidth}px")">
      <aside class="explorer">
        <header class="explorer-header">
          <div class="panel-title">ASSEMBLIES</div>
          <div class="tree-actions" aria-label="Assembly tree controls">
            <button class="tree-action" title="Collapse all nodes" aria-label="Collapse all nodes" disabled="@(Backend.Assemblies.Count == 0)" @onclick="CollapseAllNodes">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5-5 5 5"></path><path d="m7 10 5-5 5 5"></path></svg>
            </button>
          </div>
        </header>
        <VirtualizedTree Assemblies="Backend.Assemblies" EmptyMessage="@(restoring ? "Restoring assembly tree…" : "Open a managed .dll or .exe to begin.")" OnOpen="OpenTreeSymbolAsync" OnOpenReference="OpenReferenceAsync" OnOpenResource="OpenResourceAsync" OnContextMenu="OpenTreeContextMenu" ExpandedPath="revealedPath" SelectedSymbol="selectedSymbol" SelectedNode="selectedNode" SelectionVersion="treeSelectionVersion" CollapseVersion="treeCollapseVersion" />
      </aside>
      <div class="explorer-resizer" title="Drag to resize assembly tree"></div>
    </div>
    <section class="document-area">
      <nav class="tabs">
        @foreach (var tab in Workspace.Tabs) { <button class="tab @(Workspace.ActiveTabId == tab.Id ? "active" : null)" @onclick="() => ActivateTabAsync(tab.Id)" @onmouseup="e => TabMouseUp(e, tab.Id)" @onmousedown:preventDefault="true"><span>@tab.Title</span><small>@(tab.IsLoading ? "Decompiling…" : tab.AssemblyName)</small><i @onclick:stopPropagation @onclick="() => CloseTab(tab.Id)">×</i></button> }
      </nav>
      <div class="document-content">
        @if (restoring && Workspace.ActiveTab is null) { <div class="decompiling-panel"><span class="decompiling-spinner"></span><strong>Restoring session…</strong><small>Loading assemblies and rebuilding the assembly tree.</small></div> }
        else if (Workspace.ActiveTab is { IsLoading: true } loading) { <div class="decompiling-panel"><span class="decompiling-spinner"></span><strong>Decompiling @loading.Title…</strong><small>Restoring saved source after the assembly tree has loaded.</small></div> }
        else if (Workspace.ActiveTab is { Error: not null } failed) { <div class="decompiling-panel error"><strong>Decompilation failed</strong><small>@failed.Error</small></div> }
        else if (Workspace.ActiveTab is { Document.Resource: { } resource }) { <ResourceView Resource="resource" WrapLines="wrapLines" /> }
        else if (Workspace.ActiveTab is { Document.Language: "hex", Document.Binary: { } binary } hex) { <HexView Data="binary" SelectionOffset="hex.Document.BinarySelectionOffset" SelectionLength="hex.Document.BinarySelectionLength" Regions="hex.Document.BinaryRegions ?? []" /> }
        else if (Workspace.ActiveTab is { } active) { <SourceView TabId="active.Id" Document="active.Document" WrapLines="wrapLines" OnNavigate="NavigateFromSourceAsync" OnAnalyze="OpenSourceAnalyzeMenu" /> }
      </div>
      @if (bottomOpen) {
        <section class="bottom-panel" @ref="searchPanel" style="height:@($"{searchPanelHeight}px")">
          <div class="search-resizer" title="Drag to resize the panel"></div>
          <div class="bottom-tabs" role="tablist">
            <button class="bottom-tab @(bottomTab == "search" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "search")" disabled="@(Backend.Assemblies.Count == 0)" @onclick='() => SwitchBottomTab("search")'>Search</button>
            <button class="bottom-tab @(bottomTab == "analyzer" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "analyzer")" disabled="@(Backend.Assemblies.Count == 0)" @onclick='() => SwitchBottomTab("analyzer")'>Analyzer</button>
            <button class="bottom-tab @(bottomTab == "mcp" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "mcp")" @onclick='() => SwitchBottomTab("mcp")'>MCP Activity</button>
            <button class="bottom-tab @(bottomTab == "debugger" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "debugger")" @onclick='() => SwitchBottomTab("debugger")'>Debugger</button>
            <button class="bottom-close" title="Close panel" aria-label="Close panel" @onclick="CloseBottom">×</button>
          </div>
          <div class="search-panel search-embedded @(bottomTab == "search" ? null : "panel-hidden")">
            <header><input @ref="searchInput" @bind="query" @bind:event="oninput" @bind:after="QueueSearch" @onkeydown="SearchKey" placeholder="Type or member name…" /><select @bind="searchKind" @bind:after="SearchFilterChanged" title="Member type"><option value="All">All members</option><option value="Type">Types</option><option value="Method">Methods</option><option value="Field">Fields</option><option value="Property">Properties</option><option value="Event">Events</option></select><select @bind="searchScope" @bind:after="SearchFilterChanged" title="Assembly scope"><option value="All">All assemblies</option><option value="Selected" disabled="@(SelectedAssemblyMvid is null)">Selected assembly</option></select><button class="run-search" @onclick="SearchAsync">Search</button><small>@results.Count result@(results.Count == 1 ? "" : "s")</small></header>
            <div class="search-results-header" role="row">
              <span role="columnheader">Type</span><span role="columnheader">Name</span><span role="columnheader">Assembly</span>
            </div>
            <div class="search-results">
              @if (results.Count == 0) { <div class="no-results">@(string.IsNullOrWhiteSpace(query) ? "Type a name to search across open assemblies." : "No matching types or members.")</div> }
              else { <Virtualize Items="results" Context="result" ItemSize="28" OverscanCount="10">
                <button @key="result.Symbol" class="search-result" @onclick="e => OpenSearchResultAsync(result, e.CtrlKey)">
                  <span class="result-kind result-@result.Kind.ToLowerInvariant()">@result.Kind</span><span class="result-name">@(result.QualifiedName ?? result.Name)</span><span class="result-assembly">@result.AssemblyName</span>
                </button>
              </Virtualize> }
            </div>
          </div>
          <div class="analyzer-body @(bottomTab == "analyzer" ? null : "panel-hidden")">
            <AnalyzerView @ref="analyzerView" OnNavigate="NavigateFromSourceAsync" InitialRoots="analyzerRoots" OnRootsChanged="AnalyzerRootsChanged" />
          </div>
          <div class="analyzer-body @(bottomTab == "mcp" ? null : "panel-hidden")"><McpActivityPanel /></div>
          <div class="analyzer-body @(bottomTab == "debugger" ? null : "panel-hidden")">
            <DebuggerView />
          </div>
        </section>
      }
    </section>
  </main>
  <footer><span class="status-dot @(Workspace.IsBusy || Debugger.IsBusy ? "busy" : null)"></span>@Workspace.Status <span class="debug-status">@DebugStatus</span></footer>
  @if (contextAssembly is not null)
  {
    <div class="context-menu-dismiss" @onclick="CloseAssemblyContextMenu" @oncontextmenu:preventDefault></div>
    <div class="assembly-context-menu" style="--context-x:@(contextMenuX)px;--context-y:@(contextMenuY)px" @onclick:stopPropagation @oncontextmenu:preventDefault>
      <div class="context-menu-identity" title="@contextAssembly.Path"><strong>@contextAssembly.Name</strong><small>@Path.GetDirectoryName(contextAssembly.Path)</small></div>
      <button disabled="@Workspace.IsBusy" @onclick="UnloadContextAssemblyAsync"><span>Unload assembly</span></button>
    </div>
  }
  @if (contextSymbol is { } analyzeSymbol)
  {
    <div class="context-menu-dismiss" @onclick="CloseSymbolContextMenu" @oncontextmenu:preventDefault></div>
    <div class="assembly-context-menu" style="--context-x:@(contextMenuX)px;--context-y:@(contextMenuY)px" @onclick:stopPropagation @oncontextmenu:preventDefault>
      <div class="context-menu-identity"><strong>@contextSymbolName</strong><small>@contextSymbolKind</small></div>
      <button @onclick="() => AnalyzeSymbolAsync(analyzeSymbol)"><span>Analyze</span></button>
    </div>
  }
  @if (settingsOpen)
  {
    <div class="modal-dismiss" @onclick="CloseSettings"></div>
    <section class="settings-dialog" role="dialog" aria-modal="true" aria-labelledby="settings-title">
      <header><strong id="settings-title">Settings</strong><button title="Close settings" aria-label="Close settings" @onclick="CloseSettings">×</button></header>
      <div class="settings-row"><span><strong>Theme</strong><small>Application and code colours</small></span><select class="settings-select" value="@themeId" @onchange="ThemeChangedAsync">@foreach (var theme in Themes.All) { <option value="@theme.Id">@theme.Name</option> }</select></div>
      <label class="settings-row"><span><strong>Font</strong><small>Bundled and installed system fonts</small></span><select class="settings-select settings-font" value="@codeFontFamily" @onchange="CodeFontChangedAsync">@foreach (var font in AvailableCodeFonts) { <option value="@font">@font</option> }</select></label>
      <div class="settings-row"><span><strong>Application zoom</strong><small>Scale the entire interface</small></span><div class="application-zoom"><button aria-label="Zoom out" disabled="@(zoomPercent <= MinimumZoom)" @onclick="() => ChangeApplicationZoom(-1)">−</button><button class="zoom-percent" aria-label="Reset zoom to 100%" @onclick="ResetApplicationZoom">@zoomPercent%</button><button aria-label="Zoom in" disabled="@(zoomPercent >= MaximumZoom)" @onclick="() => ChangeApplicationZoom(1)">+</button></div></div>
      <label class="settings-row"><span><strong>Debug logging</strong><small>Write detailed diagnostics to the console</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@debugLogging" @onchange="DebugLoggingChanged" /></label>
      <label class="settings-row"><span><strong>Metadata tokens</strong><small>Show token and RID comments in the main panel</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@showMetadataTokens" @onchange="MetadataTokensChangedAsync" /></label>
      <label class="settings-row"><span><strong>Line wrapping</strong><small>Wrap long source and resource text lines</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@wrapLines" @onchange="LineWrappingChangedAsync" /></label>
      <label class="settings-row mcp-roots-setting"><span><strong>MCP allowed roots</strong><small>One absolute directory per line</small></span><textarea value="@mcpAllowedRoots" @onchange="McpRootsChangedAsync" placeholder="/path/to/assemblies"></textarea></label>
    </section>
  }
  @if (debugDialogOpen)
  {
    <div class="modal-dismiss" @onclick="CloseDebugDialog"></div>
    <section class="settings-dialog debug-dialog" role="dialog" aria-modal="true" aria-labelledby="debug-dialog-title">
      <header><strong id="debug-dialog-title">Start Debugging</strong><button title="Close debugger dialog" aria-label="Close debugger dialog" @onclick="CloseDebugDialog">×</button></header>
      <div class="debug-dialog-body">
        <label><span>Mode</span><select @bind="debugStartMode"><option value="launch">Launch CoreCLR</option><option value="attach">Attach CoreCLR</option></select></label>
        @if (debugStartMode == "launch")
        {
          <label><span>Managed executable or DLL</span><input @bind="debugLaunchPath" placeholder="path/to/application.dll" /></label>
          <label><span>Arguments <small>one per line</small></span><textarea @bind="debugArguments" rows="3"></textarea></label>
          <label class="debug-check"><input type="checkbox" @bind="debugStopAtEntry" /><span>Stop at entry</span></label>
        }
        else
        {
          <label><span>Process ID</span><input @bind="debugProcessId" inputmode="numeric" placeholder="1234" /></label>
        }
        @if (!string.IsNullOrWhiteSpace(Debugger.Error)) { <div class="debug-dialog-error">@Debugger.Error</div> }
      </div>
      <footer><button @onclick="CloseDebugDialog">Cancel</button><button class="primary" disabled="@Debugger.IsBusy" @onclick="StartDebuggerAsync">Start</button></footer>
    </section>
  }
</div>

@code {
  private string query = "";
  private ElementReference explorer;
  private ElementReference searchPanel;
  private IReadOnlySet<NodeId> revealedPath = new HashSet<NodeId>();
  private SymbolId? selectedSymbol;
  private NodeId? selectedNode;
  private Guid? SelectedAssemblyMvid => selectedSymbol?.ModuleMvid ?? Workspace.ActiveTab?.Document.Symbol.ModuleMvid;
  private CancellationTokenSource? saveDelay;
  private CancellationTokenSource? searchDelay;
  private readonly Dictionary<string, CancellationTokenSource> decompilations = [];
  private bool restoring;
  private ICollection<SearchResult> results = Array.Empty<SearchResult>();
  private IReadOnlyList<SearchResult> searchMatches = [];
  private bool bottomOpen;
  private string bottomTab = "search";
  private string searchKind = "All";
  private string searchScope = "All";
  private bool menuOpen;
  private bool settingsOpen;
  private bool debugDialogOpen;
  private string debugStartMode = "launch";
  private string debugLaunchPath = "";
  private string debugArguments = "";
  private string debugProcessId = "";
  private bool debugStopAtEntry = true;
  private bool focusSearch;
  private bool uiInitializationFailed;
  private ElementReference searchInput;
  private double explorerWidth = 300;
  private double searchPanelHeight = 230;
  private int treeCollapseVersion;
  private int treeSelectionVersion;
  private const int MinimumZoom = 50;
  private const int MaximumZoom = 200;
  private const int ZoomStep = 10;
  private int zoomPercent = 100;
  private string themeId = Themes.DefaultId;
  private bool debugLogging;
  private bool showMetadataTokens;
  private bool wrapLines;
  private string codeFontFamily = "DejaVu Sans Mono";
  private string[] systemFonts = [];
  private IEnumerable<string> AvailableCodeFonts => new[] { "DejaVu Sans Mono", "JetBrains Mono" }
    .Concat(systemFonts)
    .Append(codeFontFamily)
    .Where(font => !string.IsNullOrWhiteSpace(font))
    .Distinct(StringComparer.OrdinalIgnoreCase);
  private DecompilerLanguage language = DecompilerLanguage.CSharp;
  private AssemblyDescriptor? contextAssembly;
  private SymbolId? contextSymbol;
  private string contextSymbolName = "";
  private TreeNodeKind contextSymbolKind;
  private AnalyzerView? analyzerView;
  private List<AnalyzerRootState> analyzerRoots = [];
  private int contextMenuX;
  private int contextMenuY;
  private DotNetObjectReference<MainWindow>? selfReference;
  private bool sessionRestoreStarted;
  private string mcpAllowedRoots = "";
  private bool DebuggerActive => Debugger.Snapshot.Status is DebugSessionStatus.Running or DebugSessionStatus.Paused or DebugSessionStatus.Starting;
  private bool DebuggerPaused => !Debugger.IsBusy && Debugger.Snapshot.Status == DebugSessionStatus.Paused;
  private string DebugStatus => Debugger.Snapshot.Status == DebugSessionStatus.Created
    ? "Debugger idle"
    : $"Debugger: {Debugger.Snapshot.Status}";
  protected override async Task OnInitializedAsync()
  {
    Workspace.Changed += Refresh;
    Assemblies.Closing += AssemblyClosing;
    Debugger.Changed += DebuggerRefresh;
    restoring = true;
    Workspace.SetBusy(true, "Restoring session…");
    try
    {
      await Session.LoadAsync();
      var ui = Session.UiState;
      explorerWidth = Math.Clamp(ui.ExplorerWidth, 190, 1200);
      searchPanelHeight = Math.Clamp(ui.SearchPanelHeight, 120, 900);
      bottomOpen = ui.SearchOpen;
      bottomTab = ui.BottomTab is "search" or "analyzer" or "mcp" or "debugger" ? ui.BottomTab : "search";
      McpSettings.Enabled = ui.McpEnabled;
      McpSettings.SetAllowedRoots(ui.McpAllowedRoots ?? []);
      mcpAllowedRoots = string.Join(Environment.NewLine, McpSettings.AllowedRoots);
      analyzerRoots = ui.AnalyzerRoots?.ToList() ?? [];
      searchKind = ui.SearchKind;
      searchScope = ui.SearchScope;
      zoomPercent = ui.ZoomPercent <= 0 ? 100 : Math.Clamp(ui.ZoomPercent, MinimumZoom, MaximumZoom);
      themeId = Themes.Normalize(ui.ThemeId);
      debugLogging = ui.DebugLogging;
      showMetadataTokens = ui.ShowMetadataTokens;
      wrapLines = ui.WrapLines;
      codeFontFamily = string.IsNullOrWhiteSpace(ui.CodeFontFamily) ? "DejaVu Sans Mono" : ui.CodeFontFamily.Trim();
      language = ui.Language.ValidOrDefault();
      LoggingSettings.DebugEnabled = debugLogging;
      DisplaySettings.ShowMetadataTokens = showMetadataTokens;
      Zoom.SetZoom(zoomPercent);
    }
    catch (Exception ex) { restoring = false; Workspace.SetBusy(false, $"Session restore failed: {ex.Message}"); }
  }
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (uiInitializationFailed) return;
    try
    {
      if (firstRender)
      {
        selfReference = DotNetObjectReference.Create(this);
        var storedTheme = await JS.InvokeAsync<string?>("dnSpyXdx.getStoredTheme");
        var restoredFromStorage = !string.IsNullOrWhiteSpace(storedTheme) && Themes.Normalize(storedTheme) != themeId;
        if (restoredFromStorage) themeId = Themes.Normalize(storedTheme);
        await JS.InvokeVoidAsync("dnSpyXdx.applyTheme", themeId);
        await JS.InvokeVoidAsync("dnSpyXdx.applyCodeFont", codeFontFamily);
        systemFonts = await JS.InvokeAsync<string[]>("dnSpyXdx.getSystemFonts");
        await JS.InvokeVoidAsync("dnSpyXdx.initExplorerResize", explorer, selfReference);
        await JS.InvokeVoidAsync("dnSpyXdx.initHistoryButtons", selfReference);
        await JS.InvokeVoidAsync("dnSpyXdx.initPanelHorizontalWheel");
        await JS.InvokeVoidAsync("dnSpyXdx.initFileDrop", selfReference);
        StateHasChanged();
        if (restoredFromStorage) { Session.UiState = CaptureUiState(); ScheduleSave(); StateHasChanged(); }
        if (restoring && !sessionRestoreStarted) { sessionRestoreStarted = true; _ = RestoreWorkspaceAsync(); }
        if (McpSettings.Enabled) _ = StartMcpAsync();
      }
      if (bottomOpen) await JS.InvokeVoidAsync("dnSpyXdx.initSearchResize", searchPanel, selfReference);
      if (focusSearch) { focusSearch = false; await searchInput.FocusAsync(); }
    }
    catch (Exception ex) { uiInitializationFailed = true; Workspace.SetBusy(false, $"UI initialization warning: {ex.Message}"); }
  }
  private void Refresh() { InvokeAsync(StateHasChanged); if (!restoring) ScheduleSave(); }
  private void DebuggerRefresh() => _ = InvokeAsync(() =>
  {
    if (Debugger.Snapshot.Status is DebugSessionStatus.Starting or DebugSessionStatus.Running or DebugSessionStatus.Paused)
    {
      bottomOpen = true;
      bottomTab = "debugger";
    }
    StateHasChanged();
  });
  private async Task RestoreWorkspaceAsync()
  {
    var restored = false;
    try
    {
      await Session.RestoreAssembliesAsync();
      await InvokeAsync(StateHasChanged);
      await Session.RestoreDocumentsAsync();
      if (Workspace.ActiveTab is { } active)
      {
        selectedSymbol = active.Document.Symbol;
        try { revealedPath = (await Backend.GetPathAsync(active.Document.Symbol)).ToHashSet(); }
        catch (Exception ex) { Workspace.SetBusy(true, $"Could not reveal restored document: {ex.Message}"); }
      }
      restored = true;
    }
    catch (Exception ex) { Workspace.SetBusy(true, $"Session restore failed: {ex.Message}"); }
    finally
    {
      restoring = false;
      if (bottomOpen && Backend.Assemblies.Count == 0) bottomTab = "mcp";
      Workspace.SetBusy(false, restored && Backend.Assemblies.Count > 0 ? "Session restored" : restored ? "Ready" : "Session restore skipped");
      await InvokeAsync(StateHasChanged);
    }
  }
  private void ScheduleSave() { saveDelay?.Cancel(); saveDelay?.Dispose(); saveDelay = new CancellationTokenSource(); var token = saveDelay.Token; _ = SaveAfterDelayAsync(token); }
  private UiSessionState CaptureUiState() => new(explorerWidth, searchPanelHeight, bottomOpen, searchKind, searchScope, zoomPercent, themeId, debugLogging, language, showMetadataTokens, wrapLines, codeFontFamily, bottomTab, analyzerRoots, McpSettings.Enabled, McpSettings.AllowedRoots.ToArray());
  private void AnalyzerRootsChanged(IReadOnlyList<AnalyzerRootState> updated) { analyzerRoots = updated.ToList(); ScheduleSave(); }
  private async Task SaveAfterDelayAsync(CancellationToken token) { try { await Task.Delay(350, token); Session.UiState = CaptureUiState(); await Session.SaveAsync(token); } catch (OperationCanceledException) { } }
  private async Task OpenAsync() { var path = await Dialogs.OpenAssemblyAsync(); if (path is null) return; Workspace.SetBusy(true, "Opening assembly…"); try { await Assemblies.OpenAsync(path, "desktop"); } catch (Exception ex) { Workspace.SetBusy(false, ex.Message); } }
  // Files dropped from the OS reach the WebView without their real path, so the bytes are staged into a
  // shared per-drop folder (sibling assemblies land together, keeping reference resolution working) and
  // then opened by path through the normal pipeline.
  private static string DropBatchDirectory(string batch) => Path.Combine(Path.GetTempPath(), "DnSpyXDX-Dropped", new string(batch.Where(character => char.IsLetterOrDigit(character) || character == '-').ToArray()) is { Length: > 0 } safe ? safe : "batch");
  [JSInvokable] public async Task StageDroppedAssembly(string batch, string name, byte[] data)
  {
    var directory = DropBatchDirectory(batch);
    Directory.CreateDirectory(directory);
    await File.WriteAllBytesAsync(Path.Combine(directory, Path.GetFileName(name)), data);
  }
  [JSInvokable] public async Task OpenDroppedAssemblies(string batch, string[] names)
  {
    var directory = DropBatchDirectory(batch);
    Workspace.SetBusy(true, names.Length == 1 ? "Opening dropped assembly…" : $"Opening {names.Length} dropped assemblies…");
    var opened = 0;
    string? lastError = null;
    foreach (var name in names)
    {
      try { await Assemblies.OpenAsync(Path.Combine(directory, Path.GetFileName(name)), "drag and drop"); opened++; }
      catch (Exception ex) { lastError = ex.Message; }
    }
    var message = opened == names.Length
      ? opened == 1 ? $"Opened {Path.GetFileName(names[0])}" : $"Opened {opened} assemblies"
      : opened > 0 ? $"Opened {opened} of {names.Length}; last error: {lastError}"
      : $"Could not open dropped file: {lastError}";
    Workspace.SetBusy(false, message);
    await InvokeAsync(StateHasChanged);
  }
