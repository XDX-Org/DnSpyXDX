  private static bool IsAssemblyPath(string path) =>
    string.Equals(Path.GetExtension(path), ".dll", StringComparison.OrdinalIgnoreCase)
    || string.Equals(Path.GetExtension(path), ".exe", StringComparison.OrdinalIgnoreCase)
    || string.Equals(Path.GetExtension(path), ".winmd", StringComparison.OrdinalIgnoreCase);
  private async Task OpenDroppedAssembliesAsync(IReadOnlyList<string> droppedPaths)
  {
    var paths = droppedPaths
      .Where(File.Exists)
      .Where(IsAssemblyPath)
      .Distinct(StringComparer.OrdinalIgnoreCase)
      .ToArray();
    if (paths.Length == 0) { Workspace.SetBusy(false, "Drop a .dll, .exe, or .winmd file to open it"); return; }
    Workspace.SetBusy(true, paths.Length == 1 ? "Opening dropped assembly…" : $"Opening {paths.Length} dropped assemblies…");
    var opened = 0;
    string? lastError = null;
    foreach (var path in paths)
    {
      try { await Assemblies.OpenAsync(path, "drag and drop"); opened++; }
      catch (Exception ex) { lastError = ex.Message; }
    }
    var message = opened == paths.Length
      ? opened == 1 ? $"Opened {Path.GetFileName(paths[0])}" : $"Opened {opened} assemblies"
      : opened > 0 ? $"Opened {opened} of {paths.Length}; last error: {lastError}"
      : $"Could not open dropped file: {lastError}";
    Workspace.SetBusy(false, message);
    await InvokeAsync(StateHasChanged);
  }
