  private DebugStartConfiguration CaptureDebugConfiguration()
  {
    var name = debugConfigurationName.Trim();
    if (name.Length == 0)
      name = debugStartMode switch
      {
        "attach" => "CoreCLR attach",
        "mono" => $"Mono {debugMonoHost.Trim()}:{debugMonoPort}",
        _ => string.IsNullOrWhiteSpace(debugLaunchPath)
          ? "CoreCLR launch"
          : Path.GetFileNameWithoutExtension(debugLaunchPath)
      };
    int.TryParse(debugProcessId, out var processId);
    int.TryParse(debugMonoPort, out var monoPort);
    return new DebugStartConfiguration(
      selectedDebugConfiguration ?? Guid.NewGuid(),
      name,
      debugStartMode,
      debugLaunchPath,
      debugArguments,
      debugWorkingDirectory,
      debugEnvironment,
      debugStopAtEntry,
      processId > 0 ? processId : null,
      debugMonoHost,
      monoPort is > 0 and <= 65535 ? monoPort : 55555);
  }
  private void ApplyDebugConfiguration(DebugStartConfiguration configuration)
  {
    debugConfigurationName = configuration.Name;
    debugStartMode = configuration.Mode is "attach" or "mono"
      ? configuration.Mode
      : "launch";
    debugLaunchPath = configuration.LaunchPath;
    debugArguments = configuration.Arguments;
    debugWorkingDirectory = configuration.WorkingDirectory;
    debugEnvironment = configuration.Environment;
    debugStopAtEntry = configuration.StopAtEntry;
    debugProcessId = configuration.ProcessId?.ToString(
      System.Globalization.CultureInfo.InvariantCulture) ?? "";
    debugMonoHost = configuration.MonoHost;
    debugMonoPort = configuration.MonoPort.ToString(
      System.Globalization.CultureInfo.InvariantCulture);
  }
  private bool TryParseDebugEnvironment(
    out IReadOnlyDictionary<string, string>? environment,
    out string? error)
  {
    var values = new Dictionary<string, string>(
      OperatingSystem.IsWindows()
        ? StringComparer.OrdinalIgnoreCase
        : StringComparer.Ordinal);
    foreach (var raw in debugEnvironment.Split(
      ['\r', '\n'],
      StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries))
    {
      var separator = raw.IndexOf('=');
      if (separator <= 0)
      {
        environment = null;
        error = $"Invalid environment entry '{raw}'. Use KEY=VALUE.";
        return false;
      }
      var key = raw[..separator].Trim();
      if (key.Length == 0 || key.Contains('\0') || key.Contains('='))
      {
        environment = null;
        error = $"Invalid environment variable name in '{raw}'.";
        return false;
      }
      values[key] = raw[(separator + 1)..];
    }
    environment = values.Count == 0 ? null : values;
    error = null;
    return true;
  }
  private async Task StartDebuggerAsync()
  {
    if (debugStartMode == "attach")
    {
      if (!int.TryParse(debugProcessId, out var processId) || processId <= 0)
      {
        Workspace.SetBusy(false, "Debugger requires a positive process ID.");
        return;
      }
      await Debugger.AttachAsync(processId);
    }
    else if (debugStartMode == "mono")
    {
      if (string.IsNullOrWhiteSpace(debugMonoHost) ||
          !int.TryParse(debugMonoPort, out var port) ||
          port is <= 0 or > 65535)
      {
        Workspace.SetBusy(false, "Mono attach requires a host and port from 1 through 65535.");
        return;
      }
      await Debugger.AttachMonoAsync(debugMonoHost.Trim(), port);
    }
    else
    {
      var inspection = DebugLaunchTargetInspector.Inspect(debugLaunchPath);
      if (!inspection.IsLaunchable)
      {
        debugDialogError = inspection.Error;
        return;
      }
      debugDialogError = null;
      var arguments = debugArguments
        .Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
      var workingDirectory = string.IsNullOrWhiteSpace(debugWorkingDirectory)
        ? null
        : Path.GetFullPath(debugWorkingDirectory.Trim());
      if (workingDirectory is not null && !Directory.Exists(workingDirectory))
      {
        debugDialogError = $"Working directory does not exist: {workingDirectory}";
        return;
      }
      if (!TryParseDebugEnvironment(out var environment, out var environmentError))
      {
        debugDialogError = environmentError;
        return;
      }
      await Assemblies.TryOpenDebuggerModuleAsync(debugLaunchPath);
      await Debugger.LaunchAsync(
        debugLaunchPath,
        arguments,
        debugStopAtEntry,
        workingDirectory,
        environment);
    }
    if (Debugger.Snapshot.Status is DebugSessionStatus.Running or
        DebugSessionStatus.Paused)
      debugDialogOpen = false;
  }
