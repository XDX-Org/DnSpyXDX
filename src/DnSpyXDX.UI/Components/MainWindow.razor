  private async Task RefreshDebugProcessesAsync()
  {
    debugDialogError = null;
    try
    {
      debugProcesses = await Task.Run(() =>
      {
        var current = Environment.ProcessId;
        var processes = new List<DebugProcessOption>();
        foreach (var process in System.Diagnostics.Process.GetProcesses())
        {
          using (process)
          {
            try
            {
              if (process.Id == current || process.HasExited) continue;
              if (!IsCoreClrProcess(process)) continue;
              processes.Add(new DebugProcessOption(
                process.Id,
                process.ProcessName,
                process.MainWindowTitle ?? ""));
            }
            catch (Exception exception) when (
              exception is InvalidOperationException or
                System.ComponentModel.Win32Exception or
                NotSupportedException)
            {
            }
          }
        }
        return (IReadOnlyList<DebugProcessOption>)processes
          .OrderBy(value => value.Name, StringComparer.OrdinalIgnoreCase)
          .ThenBy(value => value.Id)
          .ToArray();
      });
    }
    catch (Exception exception)
    {
      debugDialogError = $"Could not enumerate processes: {exception.Message}";
      debugProcesses = [];
    }
  }
  private static bool IsCoreClrProcess(
    System.Diagnostics.Process process)
  {
    try
    {
      if (OperatingSystem.IsWindows())
        return process.Modules
          .Cast<System.Diagnostics.ProcessModule>()
          .Any(module => string.Equals(
            module.ModuleName,
            "coreclr.dll",
            StringComparison.OrdinalIgnoreCase));
      if (OperatingSystem.IsLinux())
        return File.ReadLines($"/proc/{process.Id}/maps")
          .Any(line => line.Contains(
            "libcoreclr.so",
            StringComparison.Ordinal));
      return true;
    }
    catch (Exception exception) when (
      exception is InvalidOperationException or
        System.ComponentModel.Win32Exception or
        IOException or
        UnauthorizedAccessException or
        NotSupportedException)
    {
      return false;
    }
  }
