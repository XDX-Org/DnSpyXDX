@implements IDisposable
@inject IDecompilerBackend Backend
@inject IProjectExportService Exporter
@inject IFileDialogService Dialogs
@inject WorkspaceState Workspace
@inject IJSRuntime JS
@inject IWorkspaceSessionService Session
@inject IApplicationZoomService Zoom
@inject IApplicationLifetime ApplicationLifetime
@inject SourceViewStateStore SourceViewStates
@inject SourcePresentationCache SourceCache
@inject RuntimeLoggingSettings LoggingSettings
@inject RuntimeDisplaySettings DisplaySettings

<div class="app-shell">
  <header class="toolbar">
    <div class="app-menu">
      <button type="button" class="hamburger" title="Application menu" aria-label="Application menu" aria-expanded="@menuOpen" @onclick="ToggleMenu" @onclick:stopPropagation><span></span><span></span><span></span></button>
      @if (menuOpen) {
        <div class="menu-dismiss" @onclick="CloseMenu"></div>
        <div class="menu-popup">
          <div class="menu-identity"><img src="_content/DnSpyXDX.UI/images/dnspyxdx-logo.webp" alt=""><span>DnSpyXDX</span></div>
          <button @onclick="OpenFromMenuAsync" disabled="@Workspace.IsBusy"><span>Open assembly</span></button>
          <button @onclick="ExportFromMenuAsync" disabled="@(Workspace.IsBusy || Backend.Assemblies.Count == 0)"><span>Extract solution</span></button>
          <button @onclick="UnloadAllAsync" disabled="@(Workspace.IsBusy || Backend.Assemblies.Count == 0)"><span>Unload all assemblies</span></button>
          <div class="menu-separator" role="separator"></div>
          <button @onclick="OpenSettings"><span>Settings</span></button>
          <button @onclick="Exit"><span>Exit</span></button>
        </div>
      }
    </div>
    <div class="toolbar-navigation" aria-label="Document navigation">
      <button class="toolbar-icon" title="Back (Alt+Left)" aria-label="Back" disabled="@(Workspace.ActiveTab?.CanGoBack != true)" @onclick="() => NavigateHistory(false)">←</button>
      <button class="toolbar-icon" title="Forward (Alt+Right)" aria-label="Forward" disabled="@(Workspace.ActiveTab?.CanGoForward != true)" @onclick="() => NavigateHistory(true)">→</button>
    </div>
    <button class="toolbar-icon search-toolbar-button @(bottomOpen && bottomTab == "search" ? "active" : null)" title="@(bottomOpen && bottomTab == "search" ? "Close search" : "Open search")" aria-label="@(bottomOpen && bottomTab == "search" ? "Close search" : "Open search")" aria-pressed="@(bottomOpen && bottomTab == "search")" disabled="@(Backend.Assemblies.Count == 0)" @onclick="ToggleSearchPanel">
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"></circle><path d="m15.5 15.5 5 5"></path></svg>
    </button>
    <label class="language-selector"><span>Language</span><select value="@language" @onchange="LanguageChangedAsync"><option value="@DecompilerLanguage.CSharp">C#</option><option value="@DecompilerLanguage.IL">IL</option><option value="@DecompilerLanguage.ILWithCSharp">IL with C#</option><option value="@DecompilerLanguage.Hex">Hex</option></select></label>
  </header>
  <main>
    <div class="explorer-pane" @ref="explorer" style="width:@($"{explorerWidth}px")">
      <aside class="explorer">
        <header class="explorer-header">
          <div class="panel-title">ASSEMBLIES</div>
          <div class="tree-actions" aria-label="Assembly tree controls">
            <button class="tree-action" title="Collapse all nodes" aria-label="Collapse all nodes" disabled="@(Backend.Assemblies.Count == 0)" @onclick="CollapseAllNodes">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m7 15 5-5 5 5"></path><path d="m7 10 5-5 5 5"></path></svg>
            </button>
          </div>
        </header>
        <VirtualizedTree Assemblies="Backend.Assemblies" EmptyMessage="@(restoring ? "Restoring assembly tree…" : "Open a managed .dll or .exe to begin.")" OnOpen="OpenTreeSymbolAsync" OnOpenReference="OpenReferenceAsync" OnOpenResource="OpenResourceAsync" OnContextMenu="OpenTreeContextMenu" ExpandedPath="revealedPath" SelectedSymbol="selectedSymbol" SelectedNode="selectedNode" SelectionVersion="treeSelectionVersion" CollapseVersion="treeCollapseVersion" />
      </aside>
      <div class="explorer-resizer" title="Drag to resize assembly tree"></div>
    </div>
    <section class="document-area">
      <nav class="tabs">
        @foreach (var tab in Workspace.Tabs) { <button class="tab @(Workspace.ActiveTabId == tab.Id ? "active" : null)" @onclick="() => ActivateTabAsync(tab.Id)" @onmouseup="e => TabMouseUp(e, tab.Id)" @onmousedown:preventDefault="true"><span>@tab.Title</span><small>@(tab.IsLoading ? "Decompiling…" : tab.AssemblyName)</small><i @onclick:stopPropagation @onclick="() => CloseTab(tab.Id)">×</i></button> }
      </nav>
      <div class="document-content">
        @if (restoring && Workspace.ActiveTab is null) { <div class="decompiling-panel"><span class="decompiling-spinner"></span><strong>Restoring session…</strong><small>Loading assemblies and rebuilding the assembly tree.</small></div> }
        else if (Workspace.ActiveTab is { IsLoading: true } loading) { <div class="decompiling-panel"><span class="decompiling-spinner"></span><strong>Decompiling @loading.Title…</strong><small>Restoring saved source after the assembly tree has loaded.</small></div> }
        else if (Workspace.ActiveTab is { Error: not null } failed) { <div class="decompiling-panel error"><strong>Decompilation failed</strong><small>@failed.Error</small></div> }
        else if (Workspace.ActiveTab is { Document.Resource: { } resource }) { <ResourceView Resource="resource" WrapLines="wrapLines" /> }
        else if (Workspace.ActiveTab is { Document.Language: "hex", Document.Binary: { } binary } hex) { <HexView Data="binary" SelectionOffset="hex.Document.BinarySelectionOffset" SelectionLength="hex.Document.BinarySelectionLength" Regions="hex.Document.BinaryRegions ?? []" /> }
        else if (Workspace.ActiveTab is { } active) { <SourceView TabId="active.Id" Document="active.Document" WrapLines="wrapLines" OnNavigate="NavigateFromSourceAsync" OnAnalyze="OpenSourceAnalyzeMenu" /> }
      </div>
      @if (bottomOpen) {
        <section class="bottom-panel" @ref="searchPanel" style="height:@($"{searchPanelHeight}px")">
          <div class="search-resizer" title="Drag to resize the panel"></div>
          <div class="bottom-tabs" role="tablist">
            <button class="bottom-tab @(bottomTab == "search" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "search")" @onclick='() => SwitchBottomTab("search")'>Search</button>
            <button class="bottom-tab @(bottomTab == "analyzer" ? "active" : null)" role="tab" aria-selected="@(bottomTab == "analyzer")" @onclick='() => SwitchBottomTab("analyzer")'>Analyzer</button>
            <button class="bottom-close" title="Close panel" aria-label="Close panel" @onclick="CloseBottom">×</button>
          </div>
          <div class="search-panel search-embedded @(bottomTab == "search" ? null : "panel-hidden")">
            <header><input @ref="searchInput" @bind="query" @bind:event="oninput" @bind:after="QueueSearch" @onkeydown="SearchKey" placeholder="Type or member name…" /><select @bind="searchKind" @bind:after="SearchFilterChanged" title="Member type"><option value="All">All members</option><option value="Type">Types</option><option value="Method">Methods</option><option value="Field">Fields</option><option value="Property">Properties</option><option value="Event">Events</option></select><select @bind="searchScope" @bind:after="SearchFilterChanged" title="Assembly scope"><option value="All">All assemblies</option><option value="Selected" disabled="@(SelectedAssemblyMvid is null)">Selected assembly</option></select><button class="run-search" @onclick="SearchAsync">Search</button><small>@results.Count result@(results.Count == 1 ? "" : "s")</small></header>
            <div class="search-results-header" role="row">
              <span role="columnheader">Type</span><span role="columnheader">Name</span><span role="columnheader">Assembly</span>
            </div>
            <div class="search-results">
              @if (results.Count == 0) { <div class="no-results">@(string.IsNullOrWhiteSpace(query) ? "Type a name to search across open assemblies." : "No matching types or members.")</div> }
              else { <Virtualize Items="results" Context="result" ItemSize="28" OverscanCount="10">
                <button @key="result.Symbol" class="search-result" @onclick="e => OpenSearchResultAsync(result, e.CtrlKey)">
                  <span class="result-kind result-@result.Kind.ToLowerInvariant()">@result.Kind</span><span class="result-name">@(result.QualifiedName ?? result.Name)</span><span class="result-assembly">@result.AssemblyName</span>
                </button>
              </Virtualize> }
            </div>
          </div>
          <div class="analyzer-body @(bottomTab == "analyzer" ? null : "panel-hidden")">
            <AnalyzerView @ref="analyzerView" OnNavigate="NavigateFromSourceAsync" InitialRoots="analyzerRoots" OnRootsChanged="AnalyzerRootsChanged" />
          </div>
        </section>
      }
    </section>
  </main>
  <footer><span class="status-dot @(Workspace.IsBusy ? "busy" : null)"></span>@Workspace.Status</footer>
  @if (contextAssembly is not null)
  {
    <div class="context-menu-dismiss" @onclick="CloseAssemblyContextMenu" @oncontextmenu:preventDefault></div>
    <div class="assembly-context-menu" style="--context-x:@(contextMenuX)px;--context-y:@(contextMenuY)px" @onclick:stopPropagation @oncontextmenu:preventDefault>
      <div class="context-menu-identity" title="@contextAssembly.Path"><strong>@contextAssembly.Name</strong><small>@Path.GetDirectoryName(contextAssembly.Path)</small></div>
      <button disabled="@Workspace.IsBusy" @onclick="UnloadContextAssemblyAsync"><span>Unload assembly</span></button>
    </div>
  }
  @if (contextSymbol is { } analyzeSymbol)
  {
    <div class="context-menu-dismiss" @onclick="CloseSymbolContextMenu" @oncontextmenu:preventDefault></div>
    <div class="assembly-context-menu" style="--context-x:@(contextMenuX)px;--context-y:@(contextMenuY)px" @onclick:stopPropagation @oncontextmenu:preventDefault>
      <div class="context-menu-identity"><strong>@contextSymbolName</strong><small>@contextSymbolKind</small></div>
      <button @onclick="() => AnalyzeSymbolAsync(analyzeSymbol)"><span>Analyze</span></button>
    </div>
  }
  @if (settingsOpen)
  {
    <div class="modal-dismiss" @onclick="CloseSettings"></div>
    <section class="settings-dialog" role="dialog" aria-modal="true" aria-labelledby="settings-title">
      <header><strong id="settings-title">Settings</strong><button title="Close settings" aria-label="Close settings" @onclick="CloseSettings">×</button></header>
      <div class="settings-row"><span><strong>Theme</strong><small>Application and code colours</small></span><select class="settings-select" value="@themeId" @onchange="ThemeChangedAsync">@foreach (var theme in Themes.All) { <option value="@theme.Id">@theme.Name</option> }</select></div>
      <label class="settings-row"><span><strong>Font</strong><small>Bundled and installed system fonts</small></span><select class="settings-select settings-font" value="@codeFontFamily" @onchange="CodeFontChangedAsync">@foreach (var font in AvailableCodeFonts) { <option value="@font">@font</option> }</select></label>
      <div class="settings-row"><span><strong>Application zoom</strong><small>Scale the entire interface</small></span><div class="application-zoom"><button aria-label="Zoom out" disabled="@(zoomPercent <= MinimumZoom)" @onclick="() => ChangeApplicationZoom(-1)">−</button><button class="zoom-percent" aria-label="Reset zoom to 100%" @onclick="ResetApplicationZoom">@zoomPercent%</button><button aria-label="Zoom in" disabled="@(zoomPercent >= MaximumZoom)" @onclick="() => ChangeApplicationZoom(1)">+</button></div></div>
      <label class="settings-row"><span><strong>Debug logging</strong><small>Write detailed diagnostics to the console</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@debugLogging" @onchange="DebugLoggingChanged" /></label>
      <label class="settings-row"><span><strong>Metadata tokens</strong><small>Show token and RID comments in the main panel</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@showMetadataTokens" @onchange="MetadataTokensChangedAsync" /></label>
      <label class="settings-row"><span><strong>Line wrapping</strong><small>Wrap long source and resource text lines</small></span><input class="settings-checkbox" type="checkbox" role="switch" checked="@wrapLines" @onchange="LineWrappingChangedAsync" /></label>
    </section>
  }
</div>

@code {
  private string query = "";
  private ElementReference explorer;
  private ElementReference searchPanel;
  private IReadOnlySet<NodeId> revealedPath = new HashSet<NodeId>();
  private SymbolId? selectedSymbol;
  private NodeId? selectedNode;
  private Guid? SelectedAssemblyMvid => selectedSymbol?.ModuleMvid ?? Workspace.ActiveTab?.Document.Symbol.ModuleMvid;
  private CancellationTokenSource? saveDelay;
  private CancellationTokenSource? searchDelay;
  private readonly Dictionary<string, CancellationTokenSource> decompilations = [];
  private bool restoring;
  private ICollection<SearchResult> results = Array.Empty<SearchResult>();
  private IReadOnlyList<SearchResult> searchMatches = [];
  private bool bottomOpen;
  private string bottomTab = "search";
  private string searchKind = "All";
  private string searchScope = "All";
  private bool menuOpen;
  private bool settingsOpen;
  private bool focusSearch;
  private bool uiInitializationFailed;
  private ElementReference searchInput;
  private double explorerWidth = 300;
  private double searchPanelHeight = 230;
  private int treeCollapseVersion;
  private int treeSelectionVersion;
  private const int MinimumZoom = 50;
  private const int MaximumZoom = 200;
  private const int ZoomStep = 10;
  private int zoomPercent = 100;
  private string themeId = Themes.DefaultId;
  private bool debugLogging;
  private bool showMetadataTokens;
  private bool wrapLines;
  private string codeFontFamily = "DejaVu Sans Mono";
  private string[] systemFonts = [];
  private IEnumerable<string> AvailableCodeFonts => new[] { "DejaVu Sans Mono", "JetBrains Mono" }
    .Concat(systemFonts)
    .Append(codeFontFamily)
    .Where(font => !string.IsNullOrWhiteSpace(font))
    .Distinct(StringComparer.OrdinalIgnoreCase);
  private DecompilerLanguage language = DecompilerLanguage.CSharp;
  private AssemblyDescriptor? contextAssembly;
  private SymbolId? contextSymbol;
  private string contextSymbolName = "";
  private TreeNodeKind contextSymbolKind;
  private AnalyzerView? analyzerView;
  private List<AnalyzerRootState> analyzerRoots = [];
  private int contextMenuX;
  private int contextMenuY;
  private DotNetObjectReference<MainWindow>? selfReference;
  private bool sessionRestoreStarted;
  protected override async Task OnInitializedAsync()
  {
    Workspace.Changed += Refresh;
    restoring = true;
    Workspace.SetBusy(true, "Restoring session…");
    try
    {
      await Session.LoadAsync();
      var ui = Session.UiState;
      explorerWidth = Math.Clamp(ui.ExplorerWidth, 190, 1200);
      searchPanelHeight = Math.Clamp(ui.SearchPanelHeight, 120, 900);
      bottomOpen = ui.SearchOpen;
      bottomTab = ui.BottomTab is "search" or "analyzer" ? ui.BottomTab : "search";
      analyzerRoots = ui.AnalyzerRoots?.ToList() ?? [];
      searchKind = ui.SearchKind;
      searchScope = ui.SearchScope;
      zoomPercent = ui.ZoomPercent <= 0 ? 100 : Math.Clamp(ui.ZoomPercent, MinimumZoom, MaximumZoom);
      themeId = Themes.Normalize(ui.ThemeId);
      debugLogging = ui.DebugLogging;
      showMetadataTokens = ui.ShowMetadataTokens;
      wrapLines = ui.WrapLines;
      codeFontFamily = string.IsNullOrWhiteSpace(ui.CodeFontFamily) ? "DejaVu Sans Mono" : ui.CodeFontFamily.Trim();
      language = ui.Language.ValidOrDefault();
      LoggingSettings.DebugEnabled = debugLogging;
      DisplaySettings.ShowMetadataTokens = showMetadataTokens;
      Zoom.SetZoom(zoomPercent);
    }
    catch (Exception ex) { restoring = false; Workspace.SetBusy(false, $"Session restore failed: {ex.Message}"); }
  }
  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (uiInitializationFailed) return;
    try
    {
      if (firstRender)
      {
        selfReference = DotNetObjectReference.Create(this);
        var storedTheme = await JS.InvokeAsync<string?>("dnSpyXdx.getStoredTheme");
        var restoredFromStorage = !string.IsNullOrWhiteSpace(storedTheme) && Themes.Normalize(storedTheme) != themeId;
        if (restoredFromStorage) themeId = Themes.Normalize(storedTheme);
        await JS.InvokeVoidAsync("dnSpyXdx.applyTheme", themeId);
        await JS.InvokeVoidAsync("dnSpyXdx.applyCodeFont", codeFontFamily);
        systemFonts = await JS.InvokeAsync<string[]>("dnSpyXdx.getSystemFonts");
        await JS.InvokeVoidAsync("dnSpyXdx.initExplorerResize", explorer, selfReference);
        await JS.InvokeVoidAsync("dnSpyXdx.initHistoryButtons", selfReference);
        await JS.InvokeVoidAsync("dnSpyXdx.initPanelHorizontalWheel");
        StateHasChanged();
        if (restoredFromStorage) { Session.UiState = CaptureUiState(); ScheduleSave(); StateHasChanged(); }
        if (restoring && !sessionRestoreStarted) { sessionRestoreStarted = true; _ = RestoreWorkspaceAsync(); }
      }
      if (bottomOpen) await JS.InvokeVoidAsync("dnSpyXdx.initSearchResize", searchPanel, selfReference);
      if (focusSearch) { focusSearch = false; await searchInput.FocusAsync(); }
    }
    catch (Exception ex) { uiInitializationFailed = true; Workspace.SetBusy(false, $"UI initialization warning: {ex.Message}"); }
  }
  private void Refresh() { InvokeAsync(StateHasChanged); if (!restoring) ScheduleSave(); }
  private async Task RestoreWorkspaceAsync()
  {
    var restored = false;
    try
    {
      await Session.RestoreAssembliesAsync();
      await InvokeAsync(StateHasChanged);
      await Session.RestoreDocumentsAsync();
      if (Workspace.ActiveTab is { } active)
      {
        selectedSymbol = active.Document.Symbol;
        try { revealedPath = (await Backend.GetPathAsync(active.Document.Symbol)).ToHashSet(); }
        catch (Exception ex) { Workspace.SetBusy(true, $"Could not reveal restored document: {ex.Message}"); }
      }
      restored = true;
    }
    catch (Exception ex) { Workspace.SetBusy(true, $"Session restore failed: {ex.Message}"); }
    finally
    {
      restoring = false;
      Workspace.SetBusy(false, restored && Backend.Assemblies.Count > 0 ? "Session restored" : restored ? "Ready" : "Session restore skipped");
      await InvokeAsync(StateHasChanged);
    }
  }
  private void ScheduleSave() { saveDelay?.Cancel(); saveDelay?.Dispose(); saveDelay = new CancellationTokenSource(); var token = saveDelay.Token; _ = SaveAfterDelayAsync(token); }
  private UiSessionState CaptureUiState() => new(explorerWidth, searchPanelHeight, bottomOpen, searchKind, searchScope, zoomPercent, themeId, debugLogging, language, showMetadataTokens, wrapLines, codeFontFamily, bottomTab, analyzerRoots);
  private void AnalyzerRootsChanged(IReadOnlyList<AnalyzerRootState> updated) { analyzerRoots = updated.ToList(); ScheduleSave(); }
  private async Task SaveAfterDelayAsync(CancellationToken token) { try { await Task.Delay(350, token); Session.UiState = CaptureUiState(); await Session.SaveAsync(token); } catch (OperationCanceledException) { } }
  private async Task OpenAsync() { var path = await Dialogs.OpenAssemblyAsync(); if (path is null) return; Workspace.SetBusy(true, "Opening assembly…"); try { await Backend.OpenAsync(path); Workspace.SetBusy(false, $"Opened {Path.GetFileName(path)}"); } catch (Exception ex) { Workspace.SetBusy(false, ex.Message); } }
  private void ToggleMenu() => menuOpen = !menuOpen;
  private void CloseMenu() => menuOpen = false;
  private void OpenSettings() { menuOpen = false; settingsOpen = true; }
  private void CloseSettings() => settingsOpen = false;
  private async Task Exit()
  {
    menuOpen = false;
    Session.UiState = CaptureUiState();
    await Session.SaveAsync();
    ApplicationLifetime.Exit();
  }
  private async Task OpenFromMenuAsync() { menuOpen = false; await OpenAsync(); }
  private async Task ExportFromMenuAsync() { menuOpen = false; await ExportAsync(); }
  private void OpenSearchPanel() { menuOpen = false; bottomOpen = true; bottomTab = "search"; focusSearch = true; ScheduleSave(); StateHasChanged(); }
  private void ToggleSearchPanel() { if (bottomOpen && bottomTab == "search") CloseBottom(); else OpenSearchPanel(); }
  private void SwitchBottomTab(string tab) { if (tab == "search") { OpenSearchPanel(); return; } bottomTab = tab; bottomOpen = true; ScheduleSave(); StateHasChanged(); }
  private void CloseBottom() { bottomOpen = false; ScheduleSave(); StateHasChanged(); }
  private async Task UnloadAllAsync() { menuOpen = false; CancelAllDecompilations(); Workspace.SetBusy(true, "Unloading assemblies…"); foreach (var assembly in Backend.Assemblies.ToArray()) await Backend.CloseAsync(assembly.SessionId); Workspace.Clear(); SourceViewStates.Clear(); SourceCache.Clear(); searchMatches = []; results = []; query = ""; bottomOpen = false; selectedSymbol = null; selectedNode = null; revealedPath = new HashSet<NodeId>(); Workspace.SetBusy(false, "All assemblies unloaded"); }
  private void OpenAssemblyContextMenu(MouseEventArgs e, AssemblyDescriptor assembly)
  {
    menuOpen = false;
    contextAssembly = assembly;
    contextMenuX = (int)Math.Round(e.ClientX);
    contextMenuY = (int)Math.Round(e.ClientY);
  }
  private void OpenTreeContextMenu((MouseEventArgs Event, TreeNodeDescriptor Node) request)
  {
    if (request.Node.Kind == TreeNodeKind.Assembly)
    {
      var assembly = Backend.Assemblies.FirstOrDefault(candidate => candidate.SessionId == request.Node.Id.SessionId);
      if (assembly is not null) OpenAssemblyContextMenu(request.Event, assembly);
      return;
    }
    if (request.Node.Symbol is not { } symbol || !CanAnalyze(request.Node.Kind)) return;
    menuOpen = false;
    contextAssembly = null;
    contextSymbol = symbol;
    contextSymbolName = request.Node.Name;
    contextSymbolKind = request.Node.Kind;
    contextMenuX = (int)Math.Round(request.Event.ClientX);
    contextMenuY = (int)Math.Round(request.Event.ClientY);
  }
  // Types and every member kind can be analyzed; groups, namespaces, and references cannot.
  private static bool CanAnalyze(TreeNodeKind kind) => kind is TreeNodeKind.Type or TreeNodeKind.Method or TreeNodeKind.Constructor or TreeNodeKind.Field or TreeNodeKind.Property or TreeNodeKind.Event;
  private void CloseAssemblyContextMenu() => contextAssembly = null;
  private void CloseSymbolContextMenu() => contextSymbol = null;
  private void OpenSourceAnalyzeMenu(AnalyzeRequest request)
  {
    if (!CanAnalyze(request.Kind)) return;
    menuOpen = false;
    contextAssembly = null;
    contextSymbol = request.Symbol;
    contextSymbolName = request.Name;
    contextSymbolKind = request.Kind;
    contextMenuX = (int)Math.Round(request.ClientX);
    contextMenuY = (int)Math.Round(request.ClientY);
  }
  private async Task AnalyzeSymbolAsync(SymbolId symbol)
  {
    var name = contextSymbolName;
    var kind = contextSymbolKind;
    contextSymbol = null;
    bottomOpen = true;
    bottomTab = "analyzer";
    ScheduleSave();
    StateHasChanged();
    if (analyzerView is not null) await analyzerView.AnalyzeAsync(symbol, name, kind);
  }
  private async Task UnloadContextAssemblyAsync()
  {
    if (contextAssembly is not { } assembly || Workspace.IsBusy) return;
    contextAssembly = null;
    Workspace.SetBusy(true, $"Unloading {assembly.Name}…");
    foreach (var tab in Workspace.Tabs.Where(tab => tab.Document.Symbol.ModuleMvid == assembly.ModuleMvid).ToArray())
    {
      if (decompilations.TryGetValue(tab.Id, out var cancellation)) await cancellation.CancelAsync();
    }
    await Backend.CloseAsync(assembly.SessionId);
    Workspace.CloseAssembly(assembly.ModuleMvid);
    SourceViewStates.RemoveAssembly(assembly.ModuleMvid);
    SourceCache.RemoveAssembly(assembly.ModuleMvid);
    results = results.Where(result => result.Symbol.ModuleMvid != assembly.ModuleMvid).ToArray();
    searchMatches = searchMatches.Where(result => result.Symbol.ModuleMvid != assembly.ModuleMvid).ToArray();
    if (selectedNode?.SessionId == assembly.SessionId) selectedNode = null;
    if (selectedSymbol?.ModuleMvid == assembly.ModuleMvid)
    {
      selectedSymbol = Workspace.ActiveTab?.Document.Symbol;
      revealedPath = selectedSymbol is { } symbol ? (await Backend.GetPathAsync(symbol)).ToHashSet() : new HashSet<NodeId>();
    }
    Workspace.SetBusy(false, $"Unloaded {assembly.Name}");
  }
  private async Task OpenSymbolAsync(SymbolId symbol, bool newTab = false, string? displayName = null, bool isType = false, SymbolId? focusSymbol = null)
  {
    selectedSymbol = symbol;
    selectedNode = null;
    var assemblyName = Backend.Assemblies.FirstOrDefault(a => a.ModuleMvid == symbol.ModuleMvid)?.Name ?? "Assembly";
    if (!newTab && Workspace.ActiveTab is { IsLoading: true } loadingTab) CancelDecompilation(loadingTab.Id);
    if (isType || IsTypeSymbol(symbol))
    {
      var tabId = Workspace.OpenLoading(symbol, displayName ?? "Type", assemblyName, language, newTab);
      var cancellation = new CancellationTokenSource();
      decompilations[tabId] = cancellation;
      _ = DecompileTypeIntoTabAsync(tabId, symbol, focusSymbol, cancellation);
      return;
    }
    Workspace.SetBusy(true, "Decompiling…");
    try { var doc = await Backend.DecompileAsync(symbol, language); Workspace.Open(doc, assemblyName, newTab); Workspace.SetBusy(false, $"Decompiled {doc.Title}"); }
    catch (Exception ex) { Workspace.SetBusy(false, ex.Message); }
  }
  private Task OpenTreeSymbolAsync(NavigationRequest request) => OpenSymbolAsync(request.Symbol, request.NewTab || Workspace.Tabs.Count == 0, request.DisplayName, request.Kind == TreeNodeKind.Type);
  private async Task OpenReferenceAsync(NodeId reference) { Workspace.SetBusy(true, "Loading reference…"); try { var assembly = await Backend.OpenReferenceAsync(reference); revealedPath = new HashSet<NodeId> { assembly.RootNode }; selectedSymbol = null; selectedNode = assembly.RootNode; treeSelectionVersion++; Workspace.SetBusy(false, $"Opened {assembly.Name}"); StateHasChanged(); } catch (Exception ex) { Workspace.SetBusy(false, ex.Message); } }
  private async Task OpenResourceAsync((NodeId Resource, bool NewTab) request)
  {
    Workspace.SetBusy(true, "Reading resource…");
    try
    {
      var resource = await Backend.GetResourceAsync(request.Resource);
      var assemblyName = Backend.Assemblies.FirstOrDefault(assembly => assembly.SessionId == request.Resource.SessionId)?.Name ?? "Assembly";
      var document = new DecompilerDocument(resource.Symbol, resource.Name, "resource", resource.Text ?? "", [], [], Resource: resource);
      Workspace.Open(document, assemblyName, request.NewTab || Workspace.Tabs.Count == 0);
      selectedNode = request.Resource;
      selectedSymbol = null;
      Workspace.SetBusy(false, $"Opened {resource.Name}");
    }
    catch (Exception ex) { Workspace.SetBusy(false, ex.Message); }
  }
  private async Task OpenSearchResultAsync(SearchResult result, bool newTab)
  {
    revealedPath = (await Backend.GetPathAsync(result.DeclaringType)).ToHashSet();
    selectedSymbol = result.DeclaringType;
    selectedNode = null;
    treeSelectionVersion++;
    await OpenSymbolAsync(result.DeclaringType, newTab || Workspace.Tabs.Count == 0, result.Kind == "Type" ? result.Name : null, true, result.Kind == "Type" ? null : result.Symbol);
    StateHasChanged();
  }
  private async Task NavigateFromSourceAsync(NavigationRequest request)
  {
    if (!Backend.Assemblies.Any(assembly => assembly.ModuleMvid == request.Symbol.ModuleMvid))
    {
      Workspace.SetBusy(true, "Finding referenced assembly…");
      try { var assembly = await Backend.OpenAssemblyForSymbolAsync(request.Symbol); Workspace.SetBusy(false, $"Opened {assembly.Name}"); }
      catch (Exception ex) { Workspace.SetBusy(false, ex.Message); return; }
    }
    var declaringType = await Backend.GetDeclaringTypeAsync(request.Symbol);
    revealedPath = (await Backend.GetPathAsync(declaringType)).ToHashSet();
    selectedSymbol = declaringType;
    selectedNode = null;
    treeSelectionVersion++;
    if (!request.NewTab && Workspace.ActiveTab is { } active && active.Document.Symbol == declaringType && active.Document.Language == language.Key())
    {
      Workspace.FocusActive(request.Symbol);
      StateHasChanged();
      return;
    }
    await OpenSymbolAsync(declaringType, request.NewTab, IsTypeSymbol(request.Symbol) ? request.DisplayName : null, true, IsTypeSymbol(request.Symbol) ? null : request.Symbol);
    StateHasChanged();
  }
  private void TabMouseUp(MouseEventArgs e, string id) { if (e.Button == 1) CloseTab(id); }
  private static bool IsTypeSymbol(SymbolId symbol) => (symbol.MetadataToken >> 24) == 0x02;
  private async Task DecompileTypeIntoTabAsync(string tabId, SymbolId symbol, SymbolId? focusSymbol, CancellationTokenSource cancellation)
  {
    var token = cancellation.Token;
    try
    {
      var requestedLanguage = language;
      var document = await Backend.DecompileAsync(symbol, requestedLanguage, token);
      if (requestedLanguage == DecompilerLanguage.Hex && focusSymbol is { } focusedSymbol)
      {
        var focused = await Backend.DecompileAsync(focusedSymbol, requestedLanguage, token);
        document = document with { BinarySelectionOffset = focused.BinarySelectionOffset, BinarySelectionLength = focused.BinarySelectionLength, BinaryRegions = focused.BinaryRegions };
      }
      if (focusSymbol is not null) document = document with { FocusSymbol = focusSymbol };
      token.ThrowIfCancellationRequested();
      await InvokeAsync(() =>
      {
        if (!IsCurrentDecompilation(tabId, cancellation) || requestedLanguage != language) return;
        Workspace.CompleteLoading(tabId, document);
        Workspace.SetBusy(false, $"Decompiled {document.Title}");
      });
    }
    catch (OperationCanceledException) { }
    catch (Exception ex) { await InvokeAsync(() => { if (IsCurrentDecompilation(tabId, cancellation)) { Workspace.FailLoading(tabId, ex.Message); Workspace.SetBusy(false, ex.Message); } }); }
    finally
    {
      if (IsCurrentDecompilation(tabId, cancellation)) decompilations.Remove(tabId);
      cancellation.Dispose();
    }
  }
  private async Task LanguageChangedAsync(ChangeEventArgs e)
  {
    if (!Enum.TryParse<DecompilerLanguage>(e.Value?.ToString(), out var selected)) selected = DecompilerLanguage.CSharp;
    selected = selected.ValidOrDefault();
    if (selected == language) return;
    language = selected;
    Session.UiState = CaptureUiState();
    ScheduleSave();
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is not null) return;
    await RefreshTabLanguageAsync(tab);
  }
  private async Task ActivateTabAsync(string id)
  {
    Workspace.Activate(id);
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is { } resource) { selectedNode = resource.Id; selectedSymbol = null; return; }
    selectedNode = null;
    selectedSymbol = tab.Document.Symbol;
    if (tab.Document.Language != language.Key()) await RefreshTabLanguageAsync(tab);
  }
  private Task RefreshTabLanguageAsync(DocumentTab tab)
  {
    if (tab.Document.Resource is not null) return Task.CompletedTask;
    CancelDecompilation(tab.Id);
    Session.CancelDocumentRestore(tab.Id);
    Workspace.RefreshLoading(tab.Id, language);
    var cancellation = new CancellationTokenSource();
    decompilations[tab.Id] = cancellation;
    _ = DecompileTypeIntoTabAsync(tab.Id, tab.Document.Symbol, tab.Document.FocusSymbol, cancellation);
    return Task.CompletedTask;
  }
  private bool IsCurrentDecompilation(string tabId, CancellationTokenSource cancellation) => decompilations.TryGetValue(tabId, out var current) && ReferenceEquals(current, cancellation);
  private void CancelDecompilation(string tabId)
  {
    if (!decompilations.Remove(tabId, out var cancellation)) return;
    cancellation.Cancel();
  }
  private void CloseTab(string id)
  {
    var wasDecompiling = decompilations.TryGetValue(id, out var cancellation);
    if (cancellation is not null) _ = cancellation.CancelAsync();
    Session.CancelDocumentRestore(id);
    SourceViewStates.RemoveTab(id);
    Workspace.Close(id);
    if (wasDecompiling) Workspace.SetBusy(false, "Decompilation cancelled");
  }
  private void CancelAllDecompilations() { foreach (var cancellation in decompilations.Values) { cancellation.Cancel(); cancellation.Dispose(); } decompilations.Clear(); }
  [JSInvokable] public async Task NavigateHistory(bool forward)
  {
    if (!(forward ? Workspace.GoForward() : Workspace.GoBack())) return;
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is { } resource)
    {
      selectedNode = resource.Id;
      selectedSymbol = null;
      StateHasChanged();
      return;
    }
    selectedNode = null;
    selectedSymbol = tab.Document.Symbol;
    revealedPath = (await Backend.GetPathAsync(tab.Document.Symbol)).ToHashSet();
    if (tab.Document.Language != language.Key()) await RefreshTabLanguageAsync(tab);
    StateHasChanged();
  }
  private void QueueSearch() { searchDelay?.Cancel(); searchDelay?.Dispose(); searchDelay = new CancellationTokenSource(); _ = SearchAfterDelayAsync(searchDelay.Token); }
  private async Task SearchAfterDelayAsync(CancellationToken token) { try { await Task.Delay(500, token); await RunSearchAsync(token); } catch (OperationCanceledException) { } }
  private async Task SearchAsync() { searchDelay?.Cancel(); searchDelay?.Dispose(); searchDelay = new CancellationTokenSource(); try { await RunSearchAsync(searchDelay.Token); } catch (OperationCanceledException) { } }
  private async Task RunSearchAsync(CancellationToken token)
  {
    var searchedQuery = query;
    searchMatches = [];
    results = [];
    var progress = new Progress<IReadOnlyList<SearchResult>>(found =>
    {
      if (token.IsCancellationRequested) return;
      searchMatches = found;
      ApplySearchFilters(searchedQuery);
      bottomOpen = true;
      StateHasChanged();
    });
    var completed = await Backend.SearchAsync(searchedQuery, token, progress);
    token.ThrowIfCancellationRequested();
    searchMatches = completed;
    ApplySearchFilters(searchedQuery);
    bottomOpen = true;
    StateHasChanged();
  }
  private void SearchFilterChanged()
  {
    ApplySearchFilters(query);
    ScheduleSave();
    StateHasChanged();
  }
  private void ApplySearchFilters(string searchedQuery) =>
    results = RankSearchResults(searchMatches, searchedQuery, searchKind, searchScope == "Selected" ? SelectedAssemblyMvid : null);
  private static ICollection<SearchResult> RankSearchResults(IReadOnlyList<SearchResult> found, string query, string kind, Guid? moduleMvid) =>
    found.Where(result => kind == "All" || result.Kind == kind)
      .Where(result => moduleMvid is null || result.Symbol.ModuleMvid == moduleMvid)
      .OrderBy(result => SearchRank(result, query))
      .ThenBy(result => result.Kind == "Type" ? 0 : 1)
      .ThenBy(result => result.Name, StringComparer.OrdinalIgnoreCase)
      .ToArray();
  private static int SearchRank(SearchResult result, string query) =>
    result.Name.Equals(query, StringComparison.OrdinalIgnoreCase) ? 0 :
    result.QualifiedName?.Equals(query, StringComparison.OrdinalIgnoreCase) == true ? 0 :
    result.Name.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 1 :
    result.QualifiedName?.StartsWith(query, StringComparison.OrdinalIgnoreCase) == true ? 1 : 2;
  private void CloseSearch() { bottomOpen = false; ScheduleSave(); StateHasChanged(); }
