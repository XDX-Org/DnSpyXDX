  private async Task NavigateFromSourceAsync(NavigationRequest request)
  {
    if (!Backend.Assemblies.Any(assembly => assembly.ModuleMvid == request.Symbol.ModuleMvid))
    {
      Workspace.SetBusy(true, "Finding referenced assembly…");
      try { var assembly = await Backend.OpenAssemblyForSymbolAsync(request.Symbol); Workspace.SetBusy(false, $"Opened {assembly.Name}"); }
      catch (Exception ex) { Workspace.SetBusy(false, ex.Message); return; }
    }
    var declaringType = await Backend.GetDeclaringTypeAsync(request.Symbol);
    revealedPath = (await Backend.GetPathAsync(declaringType)).ToHashSet();
    selectedSymbol = declaringType;
    selectedNode = null;
    treeSelectionVersion++;
    if (!request.NewTab && Workspace.ActiveTab is { } active && active.Document.Symbol == declaringType && active.Document.Language == language.Key())
    {
      Workspace.FocusActive(request.Symbol);
      StateHasChanged();
      return;
    }
    await OpenSymbolAsync(declaringType, request.NewTab, IsTypeSymbol(request.Symbol) ? request.DisplayName : null, true, IsTypeSymbol(request.Symbol) ? null : request.Symbol);
    StateHasChanged();
  }
  private Task NavigateDebuggerLocationAsync(DebugCodeLocation location) =>
    NavigateFromSourceAsync(new NavigationRequest(
      new SymbolId(
        location.Method.ModuleMvid,
        location.Method.MetadataToken),
      NewTab: false));
  private async Task<bool> EnsureDebuggerLocationAssemblyAsync(
    DebugCodeLocation location)
  {
    if (Backend.Assemblies.Any(
        assembly => assembly.ModuleMvid == location.Method.ModuleMvid))
      return true;

    var modulePaths = Debugger.Frames
      .Where(frame =>
        frame.Location?.Method.ModuleMvid == location.Method.ModuleMvid)
      .Select(frame => frame.ModulePath)
      .Where(path => !string.IsNullOrWhiteSpace(path))
      .Cast<string>();
    if (Debugger.StartRequest is DebugLaunchRequest launch)
      modulePaths = modulePaths.Prepend(launch.ExecutablePath);

    foreach (var path in modulePaths.Distinct(
      OperatingSystem.IsWindows()
        ? StringComparer.OrdinalIgnoreCase
        : StringComparer.Ordinal))
    {
      var assembly = await Assemblies.TryOpenDebuggerModuleAsync(
        path,
        location.Method.ModuleMvid);
      if (assembly is not null) return true;
    }

    try
    {
      await Backend.OpenAssemblyForSymbolAsync(new SymbolId(
        location.Method.ModuleMvid,
        location.Method.MetadataToken));
      return true;
    }
    catch (Exception exception) when (
      exception is FileNotFoundException or
        BadImageFormatException or
        IOException or
        UnauthorizedAccessException or
        InvalidOperationException)
    {
      return false;
    }
  }

  private void TabMouseUp(MouseEventArgs e, string id) { if (e.Button == 1) CloseTab(id); }
  private static bool IsTypeSymbol(SymbolId symbol) => (symbol.MetadataToken >> 24) == 0x02;
  private async Task DecompileTypeIntoTabAsync(string tabId, SymbolId symbol, SymbolId? focusSymbol, CancellationTokenSource cancellation)
  {
    var token = cancellation.Token;
    try
    {
      var requestedLanguage = language;
      var document = await Backend.DecompileAsync(symbol, requestedLanguage, token);
      if (requestedLanguage == DecompilerLanguage.Hex && focusSymbol is { } focusedSymbol)
      {
        var focused = await Backend.DecompileAsync(focusedSymbol, requestedLanguage, token);
        document = document with { BinarySelectionOffset = focused.BinarySelectionOffset, BinarySelectionLength = focused.BinarySelectionLength, BinaryRegions = focused.BinaryRegions };
      }
      if (focusSymbol is not null) document = document with { FocusSymbol = focusSymbol };
      token.ThrowIfCancellationRequested();
      await InvokeAsync(() =>
      {
        if (!IsCurrentDecompilation(tabId, cancellation) || requestedLanguage != language) return;
        Workspace.CompleteLoading(tabId, document);
        Workspace.SetBusy(false, $"Decompiled {document.Title}");
      });
    }
    catch (OperationCanceledException) { }
    catch (Exception ex) { await InvokeAsync(() => { if (IsCurrentDecompilation(tabId, cancellation)) { Workspace.FailLoading(tabId, ex.Message); Workspace.SetBusy(false, ex.Message); } }); }
    finally
    {
      if (IsCurrentDecompilation(tabId, cancellation)) decompilations.Remove(tabId);
      cancellation.Dispose();
    }
  }
  private async Task LanguageChangedAsync(ChangeEventArgs e)
  {
    if (!Enum.TryParse<DecompilerLanguage>(e.Value?.ToString(), out var selected)) selected = DecompilerLanguage.CSharp;
    selected = selected.ValidOrDefault();
    if (selected == language) return;
    language = selected;
    Session.UiState = CaptureUiState();
    ScheduleSave();
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is not null) return;
    await RefreshTabLanguageAsync(tab);
  }
  private async Task ActivateTabAsync(string id)
  {
    Workspace.Activate(id);
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is { } resource) { selectedNode = resource.Id; selectedSymbol = null; return; }
    selectedNode = null;
    selectedSymbol = tab.Document.Symbol;
    if (tab.Document.Language != language.Key()) await RefreshTabLanguageAsync(tab);
  }
  private Task RefreshTabLanguageAsync(DocumentTab tab)
  {
    if (tab.Document.Resource is not null) return Task.CompletedTask;
    CancelDecompilation(tab.Id);
    Session.CancelDocumentRestore(tab.Id);
    Workspace.RefreshLoading(tab.Id, language);
    var cancellation = new CancellationTokenSource();
    decompilations[tab.Id] = cancellation;
    _ = DecompileTypeIntoTabAsync(tab.Id, tab.Document.Symbol, tab.Document.FocusSymbol, cancellation);
    return Task.CompletedTask;
  }
  private bool IsCurrentDecompilation(string tabId, CancellationTokenSource cancellation) => decompilations.TryGetValue(tabId, out var current) && ReferenceEquals(current, cancellation);
  private void CancelDecompilation(string tabId)
  {
    if (!decompilations.Remove(tabId, out var cancellation)) return;
    cancellation.Cancel();
  }
  private void CloseTab(string id)
  {
    var wasDecompiling = decompilations.TryGetValue(id, out var cancellation);
    if (cancellation is not null) _ = cancellation.CancelAsync();
    Session.CancelDocumentRestore(id);
    SourceViewStates.RemoveTab(id);
    Workspace.Close(id);
    if (wasDecompiling) Workspace.SetBusy(false, "Decompilation cancelled");
  }
  private void CancelAllDecompilations() { foreach (var cancellation in decompilations.Values) { cancellation.Cancel(); cancellation.Dispose(); } decompilations.Clear(); }
  [JSInvokable] public async Task NavigateHistory(bool forward)
  {
    if (!(forward ? Workspace.GoForward() : Workspace.GoBack())) return;
    if (Workspace.ActiveTab is not { } tab) return;
    if (tab.Document.Resource is { } resource)
    {
      selectedNode = resource.Id;
      selectedSymbol = null;
      StateHasChanged();
      return;
    }
    selectedNode = null;
    selectedSymbol = tab.Document.Symbol;
    revealedPath = (await Backend.GetPathAsync(tab.Document.Symbol)).ToHashSet();
    if (tab.Document.Language != language.Key()) await RefreshTabLanguageAsync(tab);
    StateHasChanged();
  }
  private void QueueSearch() { searchDelay?.Cancel(); searchDelay?.Dispose(); searchDelay = new CancellationTokenSource(); _ = SearchAfterDelayAsync(searchDelay.Token); }
  private async Task SearchAfterDelayAsync(CancellationToken token) { try { await Task.Delay(500, token); await RunSearchAsync(token); } catch (OperationCanceledException) { } }
  private async Task SearchAsync() { searchDelay?.Cancel(); searchDelay?.Dispose(); searchDelay = new CancellationTokenSource(); try { await RunSearchAsync(searchDelay.Token); } catch (OperationCanceledException) { } }
  private async Task RunSearchAsync(CancellationToken token)
  {
    var searchedQuery = query;
    searchMatches = [];
    results = [];
    var progress = new Progress<IReadOnlyList<SearchResult>>(found =>
    {
      if (token.IsCancellationRequested) return;
      searchMatches = found;
      ApplySearchFilters(searchedQuery);
      bottomOpen = true;
      StateHasChanged();
    });
    var completed = await Backend.SearchAsync(searchedQuery, token, progress);
    token.ThrowIfCancellationRequested();
    searchMatches = completed;
    ApplySearchFilters(searchedQuery);
    bottomOpen = true;
    StateHasChanged();
  }
  private void SearchFilterChanged()
  {
    ApplySearchFilters(query);
    ScheduleSave();
    StateHasChanged();
  }
  private void ApplySearchFilters(string searchedQuery) =>
    results = RankSearchResults(searchMatches, searchedQuery, searchKind, searchScope == "Selected" ? SelectedAssemblyMvid : null);
  private static ICollection<SearchResult> RankSearchResults(IReadOnlyList<SearchResult> found, string query, string kind, Guid? moduleMvid) =>
    found.Where(result => kind == "All" || result.Kind == kind)
      .Where(result => moduleMvid is null || result.Symbol.ModuleMvid == moduleMvid)
      .OrderBy(result => SearchRank(result, query))
      .ThenBy(result => result.Kind == "Type" ? 0 : 1)
      .ThenBy(result => result.Name, StringComparer.OrdinalIgnoreCase)
      .ToArray();
  private static int SearchRank(SearchResult result, string query) =>
    result.Name.Equals(query, StringComparison.OrdinalIgnoreCase) ? 0 :
    result.QualifiedName?.Equals(query, StringComparison.OrdinalIgnoreCase) == true ? 0 :
    result.Name.StartsWith(query, StringComparison.OrdinalIgnoreCase) ? 1 :
    result.QualifiedName?.StartsWith(query, StringComparison.OrdinalIgnoreCase) == true ? 1 : 2;
